---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { seoPages, seoCopy } from '../content/seo';
import { structuredData, absoluteURL, type ArticleSEO, type SocialImage } from '../lib/seo';
import { blogCopy } from '../content/blog';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { company, home } from '../content/site';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/site.css';
import tokens from '../styles/tokens.css?raw';
const themeBackgrounds = [...tokens.matchAll(/--bg:\s*([^;]+);/g)].map((match) => match[1]);
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  article?: ArticleSEO;
  socialImage?: SocialImage;
}
const pathname = Astro.url.pathname.replace(/(\.html)\/$/, '$1').replace(/^\/404\/$/, '/404.html');
const configured = seoPages[pathname];
const title = configured?.title ?? Astro.props.title;
const description = configured?.description ?? Astro.props.description ?? home.intro;
const noindex = Astro.props.noindex || configured?.noindex || false;
const canonical = new URL(pathname, company.url);
const { article } = Astro.props;
const socialImage = Astro.props.socialImage ?? {
  url: '/social.png',
  width: 1200,
  height: 630,
  type: 'image/png',
  alt: seoCopy.imageAlt,
};
const imageURL = absoluteURL(socialImage.url);
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><title>{title} | {company.name}</title><meta name="description" content={description} /><meta
      name="color-scheme"
      content="light dark"
    /><link rel="canonical" href={canonical} /><link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />{noindex && <meta name="robots" content="noindex,follow" />}<meta
      property="og:title"
      content={`${title} | ${company.name}`}
    /><meta property="og:description" content={description} /><meta
      property="og:type"
      content={article ? 'article' : 'website'}
    /><meta property="og:url" content={canonical} /><meta
      property="og:image"
      content={imageURL}
    /><meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:type" content={socialImage.type} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${company.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={blogCopy.feedTitle}
      href={absoluteURL('/rss.xml')}
    />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.pubDate.toISOString()} />
          {article.updatedDate && (
            <meta property="article:modified_time" content={article.updatedDate.toISOString()} />
          )}
          <meta property="article:section" content={article.category} />
          <meta name="author" content={article.author} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta
      name="theme-color"
      content={themeBackgrounds[0]}
      media="(prefers-color-scheme: light)"
    /><meta name="theme-color" content={themeBackgrounds[1]} media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const t = localStorage.getItem('ftt:theme');
        document.documentElement.dataset.theme =
          t === 'light' || t === 'dark'
            ? t
            : matchMedia('(prefers-color-scheme:dark)').matches
              ? 'dark'
              : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme:dark)').matches
          ? 'dark'
          : 'light';
      }
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        structuredData(pathname, `${title} | ${company.name}`, description, article, imageURL),
      ).replace(/</g, '\\u003c')}
    />
    <noscript
      ><style>
        .main-nav {
          display: flex;
          width: 100%;
          order: 5;
        }
        .menu-toggle,
        .theme-button,
        [data-consent-manage] {
          display: none;
        }
      </style></noscript
    ></head
  ><body
    ><Header /><main id="main"><Breadcrumbs title={article?.title ?? title} /><slot /></main><Footer
    /><Consent /><script>
      import '../scripts/site';
    </script></body
  >
</html>
