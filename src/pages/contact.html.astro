---
import SiteLayout from '../layouts/SiteLayout.astro';
import StaticRedirect from '../components/StaticRedirect.astro';
import { contactRedirect, ui } from '../content/site';
---

<SiteLayout title={contactRedirect.title}>
  <StaticRedirect
    title={contactRedirect.title}
    message={contactRedirect.message}
    destination={contactRedirect.destination}
    label={ui.start}
    id="contact-redirect-link"
  />
</SiteLayout>
