---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ShowcaseImage from '../../components/ShowcaseImage.astro';
import { showcase, showcaseIndex as c } from '../../data/showcase';
const first = showcase[0];
---

<SiteLayout
  title={c.title}
  description={c.description}
  socialImage={{
    url: first.image.src,
    width: first.image.width,
    height: first.image.height,
    type: 'image/png',
    alt: first.image.alt,
  }}
>
  <div class="container directory">
    <h1>{c.title}</h1>
    <p class="lead">{c.intro}</p>
    <ul class="kits">
      {
        showcase.map((kit, i) => (
          <li>
            <a class="service-card kit" href={kit.url} aria-labelledby={`kit-${kit.id}`}>
              <ShowcaseImage
                src={kit.image.src}
                alt={kit.image.alt}
                width={kit.image.width}
                height={kit.image.height}
                sizes="(min-width: 48rem) 50vw, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <h2 id={`kit-${kit.id}`}>
                {kit.trade}
                <span aria-hidden="true">→</span>
              </h2>
              <p class="muted">{kit.description}</p>
              <span class="more">{c.cardLink}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</SiteLayout>

<style>
  .directory {
    padding-block: var(--space-6) var(--space-9);
  }
  .kits {
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }
  .kits li {
    margin: 0;
  }
  @media (--tablet) {
    .kits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .kit {
    display: block;
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .kit :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--h3);
  }
  h2 span,
  .more {
    color: var(--accent);
  }
  .kit p {
    margin-bottom: var(--space-3);
  }
  .more {
    font-weight: var(--weight-strong);
  }
</style>
