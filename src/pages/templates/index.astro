---
import ServiceVisual from '../../components/ServiceVisual.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { templateCategories, templateDirectory } from '../../content/templates';
---

<SiteLayout title={templateDirectory.title} description={templateDirectory.description}>
  <div class="container directory">
    <h1>{templateDirectory.title}</h1>
    <div class="service-grid">
      {
        templateCategories.map(({ title, service, route }) => (
          <a class="service-card" href={route} aria-labelledby={service}>
            <ServiceVisual service={service} />
            <h2 id={service}>
              {title}
              <span aria-hidden="true">→</span>
            </h2>
          </a>
        ))
      }
    </div>
  </div>
</SiteLayout>

<style>
  .directory {
    padding-block: var(--space-6) var(--space-9);
  }
  .service-card {
    padding: var(--space-4);
  }
  h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: var(--h3);
  }
  h2 span {
    color: var(--accent);
  }
</style>
