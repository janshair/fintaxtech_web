---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import StaticRedirect from '../../../../../components/StaticRedirect.astro';
import { placeholderRedirect as c } from '../../../../../content/templates';
---

<SiteLayout title={c.title}>
  <StaticRedirect
    title={c.title}
    message={c.message}
    destination={c.destination}
    label={c.label}
    id="placeholder-redirect-link"
  />
</SiteLayout>
