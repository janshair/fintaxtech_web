---
import { plumbingDemo as c } from '../../../../../content/plumbing-demo';
import { motionTemplates, motionGallery, templateSocial } from '../../../../../content/templates';
import { seoPages } from '../../../../../content/seo';
import { absoluteURL, structuredData } from '../../../../../lib/seo';
const template = motionTemplates.find((item) => item.id === c.id)!;
const { title, description } = seoPages[c.route];
const canonical = absoluteURL(c.route);
// Neutral link preview: crawlers ignore ?name=, so it names no business.
const social = templateSocial(template);
const image = absoluteURL(social.image);
const assets = c.route;
// The sample business and its FAQ, kept from the approved template. identity.js
// updates the Plumber node's name, area and phone for personalised previews.
const business = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Plumber',
      name: 'Copperwell Plumbing & Heating',
      description:
        'Plumbing and heating for homes: boiler repairs and servicing, leaks and burst pipes, radiators, bathrooms and showers.',
      telephone: '01632 960123',
      areaServed: 'Your town and nearby',
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Saturday',
          opens: '09:00',
          closes: '13:00',
        },
      ],
      knowsAbout: [
        'Boiler repair',
        'Boiler servicing',
        'Leak repair',
        'Radiators',
        'Bathroom installation',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What should I do if a pipe bursts?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Turn off the water at your stopcock (often under the kitchen sink), switch off the electrics near the water if it is safe to do so, then call us. Send a photo on WhatsApp so we know what to bring.',
          },
        },
        {
          '@type': 'Question',
          name: 'How often should my boiler be serviced?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Most boiler manufacturers recommend a service once a year, and many warranties need it. Sign up for a free reminder and we will message you when it is due.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I get a quote without a visit?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Often, yes. Send a photo or a short video of the problem and we will tell you what is involved. For bigger jobs we will arrange a visit first.',
          },
        },
        {
          '@type': 'Question',
          name: 'Will you tell me the cost before you start?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. You get a clear quote before any work starts, and nothing extra is done without your OK.',
          },
        },
        {
          '@type': 'Question',
          name: 'Which areas do you cover?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We cover our home town and the surrounding villages. Send your postcode and we will confirm.',
          },
        },
      ],
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#0a1d29" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/mark.svg" />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={social.description}
    />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} /><meta
      property="og:image:alt"
      content={social.alt}
    />
    <meta property="og:image:width" content={String(social.width)} /><meta
      property="og:image:height"
      content={String(social.height)}
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    />
    <meta name="twitter:description" content={social.description} /><meta
      name="twitter:image"
      content={image}
    /><meta name="twitter:image:alt" content={social.alt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        structuredData(c.route, title, description, undefined, image),
      ).replace(/</g, '\\u003c')}
    />
    <script
      is:inline
      type="application/ld+json"
      id="ld-business"
      set:html={business.replace(/</g, '\\u003c')}
    />
    <link rel="stylesheet" href={`${assets}styles.css`} />
    <!-- Blocking: fills ?name= / &area= / &phone= before first paint. -->
    <script is:inline src="/templates/website/motion/plumbing-10/identity.js"></script>
  </head>
  <body>
    <a class="skip" href="#top">Skip to content</a>
    <aside class="demo-strip" aria-label="Demonstration controls">
      <a href="/" class="agency">FinTaxTech <span aria-hidden="true">↗</span></a>
      <span class="demo-id">{c.label}</span>
      <a class="gallery-link" href={motionGallery.route}>All templates</a>
      <a href="/contact/">Discuss this website</a>
    </aside>

    <header class="top">
      <div class="wrap">
        <a class="brand" href="#top" aria-label="Home">
          <svg viewBox="0 0 120 120" width="38" height="38" aria-hidden="true"
            ><path
              d="M60 8 C60 8 20 52 20 76 A40 40 0 0 0 100 76 C100 52 60 8 60 8 Z"
              fill="#EEF4F6"></path><path
              d="M60 46 C61 58 76 64 76 82 A16 16 0 0 1 44 82 C44 72 49 67 52 60 C54 66 56 69 59 70 C57 62 57 54 60 46 Z"
              fill="#C8743A"></path><path
              d="M60 72 C62 77 67 79 67 86 A7 7 0 0 1 53 86 C53 81 57 78 60 72 Z"
              fill="#39B6C4"></path></svg
          >
          <span><span data-business>Copperwell</span><small>PLUMBING &amp; HEATING</small></span>
        </a>
        <nav>
          <a href="#services">Services</a><a href="#quote">Get a quote</a><a href="#faq">FAQ</a><a
            href="#contact">Contact</a>
        </nav>
        <a class="call" href="tel:01632960123" data-call>Call now</a>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="drops" aria-hidden="true"></div>
        <div class="wrap" style="position:relative">
          <svg class="hero-mark" viewBox="0 0 120 120" aria-hidden="true"
            ><path
              d="M60 8 C60 8 20 52 20 76 A40 40 0 0 0 100 76 C100 52 60 8 60 8 Z"
              fill="#EEF4F6"></path><g class="flame"
              ><path
                d="M60 46 C61 58 76 64 76 82 A16 16 0 0 1 44 82 C44 72 49 67 52 60 C54 66 56 69 59 70 C57 62 57 54 60 46 Z"
                fill="#C8743A"></path><path
                d="M60 72 C62 77 67 79 67 86 A7 7 0 0 1 53 86 C53 81 57 78 60 72 Z"
                fill="#39B6C4"></path></g
            ></svg
          >
          <div class="eyebrow">Plumbing &amp; heating · <span data-area>your area</span></div>
          <h1>No heat? A leak?<br />Sorted, properly.</h1>
          <p class="lead">
            <span data-business>Copperwell</span> fixes boilers, leaks and heating for homes in <span
              data-area>your area</span
            >. Send a photo for a clear quote, or call and talk to a real person.
          </p>
          <div class="ctas">
            <a class="btn btn-copper" href="tel:01632960123" data-call>📞 Call now</a>
            <a class="btn btn-ghost" href="#quote">📷 Send a photo for a quote</a>
          </div>
          <div class="ok">
            <span>Clear quote before any work</span><span>Tidy, careful engineers</span><span
              >Free boiler service reminders</span>
          </div>
        </div>
      </section>

      <div class="emergency">
        <div class="wrap">
          <span>💧 Water where it shouldn't be? Turn off your stopcock, then call us.</span>
          <a href="tel:01632960123" data-call>Call <span data-phone>01632 960123</span></a>
        </div>
      </div>

      <section id="services">
        <div class="wrap">
          <div class="eyebrow reveal">What we do</div>
          <h2 class="reveal">Everything warm and watertight</h2>
          <div class="grid3" style="margin-top:26px">
            <div class="card reveal">
              <div class="ic">🔥</div><h3>Boiler repairs</h3><p>
                No heating or hot water? We find the fault and explain it in plain English.
              </p>
            </div>
            <div class="card reveal">
              <div class="ic">🛠️</div><h3>Boiler servicing</h3><p>
                A yearly check to keep it safe and efficient, with a reminder when it's due.
              </p>
            </div>
            <div class="card reveal">
              <div class="ic">💧</div><h3>Leaks &amp; burst pipes</h3><p>
                From a dripping tap to water through the ceiling, we stop it fast.
              </p>
            </div>
            <div class="card reveal">
              <div class="ic">♨️</div><h3>Radiators &amp; heating</h3><p>
                Cold spots, noisy pipes, new radiators or smart thermostats.
              </p>
            </div>
            <div class="card reveal">
              <div class="ic">🚿</div><h3>Bathrooms &amp; showers</h3><p>
                New showers, toilets and full bathroom fits, finished neatly.
              </p>
            </div>
            <div class="card reveal">
              <div class="ic">🚽</div><h3>Taps, toilets &amp; blockages</h3><p>
                The everyday jobs, done properly the first time.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="quote" style="background:#fff">
        <div class="wrap two">
          <div>
            <div class="eyebrow reveal">How it works</div>
            <h2 class="reveal">Three steps, no surprises</h2>
            <div class="steps" style="margin-top:24px">
              <div class="step reveal">
                <h3>Send a photo</h3><p style="color:#4c6573;margin:0">
                  Snap the problem and tell us your postcode. It takes a minute.
                </p>
              </div>
              <div class="step reveal">
                <h3>Get a clear quote</h3><p style="color:#4c6573;margin:0">
                  We tell you what's involved and what it costs before any work starts.
                </p>
              </div>
              <div class="step reveal">
                <h3>We fix it and tidy up</h3><p style="color:#4c6573;margin:0">
                  Dust sheets down, shoes covered, and nothing extra without your OK.
                </p>
              </div>
            </div>
          </div>
          <div class="quote reveal" id="quoteBox">
            <form id="qf">
              <h3 style="font-size:24px">Get a quote from <span data-business>Copperwell</span></h3>
              <label>What's the problem?</label>
              <div class="chips" data-group="p">
                <button type="button" class="chip on" aria-pressed="true">Boiler</button><button
                  type="button"
                  class="chip"
                  aria-pressed="false">Leak</button
                ><button type="button" class="chip" aria-pressed="false">Radiators</button><button
                  type="button"
                  class="chip"
                  aria-pressed="false">Bathroom</button
                ><button type="button" class="chip" aria-pressed="false">Something else</button>
              </div>
              <label>How urgent?</label>
              <div class="chips" data-group="u">
                <button type="button" class="chip" aria-pressed="false">Emergency</button><button
                  type="button"
                  class="chip on"
                  aria-pressed="true">This week</button
                ><button type="button" class="chip" aria-pressed="false">No rush</button>
              </div>
              <label>Add a photo</label>
              <div class="photo" role="button" tabindex="0">📷 Tap to add a photo or video</div>
              <label for="pc">Postcode</label>
              <input id="pc" placeholder="e.g. AB1 2CD" autocomplete="postal-code" />
              <button class="btn btn-copper" style="width:100%;justify-content:center" type="submit"
                >Send for a quote</button
              >
              <div class="demo-note">
                Demo only: nothing is sent. Your real website connects to your own inbox or booking
                tool.
              </div>
            </form>
            <div class="done" id="qdone">
              <div class="tick">✓</div><h3>Thanks, that's with us</h3><p style="color:var(--muted)">
                In a live site, <span data-business>Copperwell</span> would get your photo and postcode
                straight away and reply with a quote.
              </p><button class="btn btn-ghost" id="qagain" type="button">Try again</button>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <div class="remind reveal">
            <div>
              <div class="eyebrow">Free reminder</div><h2 style="font-size:32px">
                Never miss a boiler service
              </h2><p style="color:#4c6573;margin:0">
                We'll send you one friendly message when your yearly service is due. That's it.
              </p>
            </div>
            <form id="remind-form">
              <input placeholder="Mobile or email" aria-label="Mobile or email" /><button
                class="btn btn-navy"
                type="submit">Remind me</button>
            </form>
          </div>
        </div>
      </section>

      <section id="faq" style="padding-top:20px">
        <div class="wrap" style="max-width:820px">
          <div class="eyebrow reveal">Questions</div>
          <h2 class="reveal">Quick answers</h2>
          <details class="reveal" open>
            <summary>What should I do if a pipe bursts?</summary><p>
              Turn off the water at your stopcock (often under the kitchen sink), switch off the
              electrics near the water if it's safe to do so, then call us. Send a photo on WhatsApp
              so we know what to bring.
            </p>
          </details>
          <details class="reveal">
            <summary>How often should my boiler be serviced?</summary><p>
              Most boiler manufacturers recommend a service once a year, and many warranties need
              it. Sign up for a free reminder and we'll message you when it's due.
            </p>
          </details>
          <details class="reveal">
            <summary>Can I get a quote without a visit?</summary><p>
              Often, yes. Send a photo or a short video and we'll tell you what's involved. For
              bigger jobs we'll arrange a visit first.
            </p>
          </details>
          <details class="reveal">
            <summary>Will you tell me the cost before you start?</summary><p>
              Yes. You get a clear quote before any work starts, and nothing extra is done without
              your OK.
            </p>
          </details>
          <details class="reveal">
            <summary>Which areas do you cover?</summary><p>
              We cover <span data-area>your area</span> and the surrounding villages. Send your postcode
              and we'll confirm.
            </p>
          </details>
        </div>
      </section>

      <section class="contact" id="contact">
        <div class="wrap">
          <div class="eyebrow">Get in touch</div>
          <h2>Talk to <span data-business>Copperwell</span></h2>
          <p style="color:var(--muted);margin:0">Mon–Fri 8:00–18:00 · Sat 9:00–13:00</p>
          <div class="row">
            <a href="tel:01632960123" data-call>📞 Call<b data-phone>01632 960123</b></a>
            <a href="#quote">💬 WhatsApp a photo<b>Get a quick quote</b></a>
            <a href="#quote">✉️ Email<b>Send us the details</b></a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      © <span data-business>Copperwell</span> Plumbing &amp; Heating · <span data-area
        >your area</span
      ><br />Website template by FinTaxTech. Sample business and demo phone number (01632 numbers
      are reserved for fiction).
    </footer>

    <div class="mbar">
      <a href="tel:01632960123" data-call style="background:#C8743A">📞 Call</a><a
        href="#quote"
        style="background:#16384c">📷 Quote</a>
    </div>

    <script is:inline src="/templates/website/motion/plumbing-10/app.js"></script>
  </body>
</html>
