---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import { templateTheme } from '../../../../../lib/template-theme';
import { THEME, consultantDemo as c, rolePresets } from '../../../../../content/consultant-demo';
import { motionTemplates, motionGallery } from '../../../../../content/templates';
import { seoPages } from '../../../../../content/seo';
import { absoluteURL, structuredData } from '../../../../../lib/seo';
import ConsultantArtwork from '../../../../../components/templates/ConsultantArtwork.astro';
const template = motionTemplates.find((item) => item.id === c.id)!;
const { title, description } = seoPages[c.route];
const canonical = absoluteURL(c.route);
const image = absoluteURL(template.preview.src);
const theme = templateTheme('consultant-07', THEME);
---

<!doctype html>
<html lang="en" style={theme.style} data-custom-theme={theme.custom || undefined}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content={theme.pageBackground} />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/mark.svg" />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} /><meta
      property="og:image:alt"
      content={template.preview.alt}
    />
    <meta property="og:image:width" content={String(template.preview.width)} /><meta
      property="og:image:height"
      content={String(template.preview.height)}
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    />
    <meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={image}
    /><meta name="twitter:image:alt" content={template.preview.alt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        structuredData(c.route, title, description, undefined, image),
      ).replace(/</g, '\\u003c')}
    />
    <link rel="stylesheet" href="/templates/website/motion/consultant-07/styles.css" />
    <!-- The blocking script observes streamed identity nodes before their first paint.
         Values are assigned only as text, or as tel:/wa.me links built from digits.
         No query data enters requests or storage. -->
    <script
      is:inline
      type="application/json"
      id="role-presets"
      set:html={JSON.stringify(rolePresets).replace(/</g, '\\u003c')}
    />
    <script is:inline src="/templates/website/motion/consultant-07/identity.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <aside class="demo-strip" aria-label="Demonstration controls">
      <a href="/" class="agency">FinTaxTech <span aria-hidden="true">↗</span></a>
      <span class="demo-id">{c.label}</span>
      <a class="gallery-link" href={motionGallery.route}>All templates</a>
      <a class="agency-contact" href="/contact/" data-agency-link>Discuss this website</a>
      <button type="button" data-edit>Change name</button>
    </aside>
    <header class="business-header wrap">
      <a class="brand" href="#home" aria-label="Back to the top"
        ><span class="monogram" data-monogram aria-hidden="true">{c.monogram}</span><span
          data-business>{c.name}</span
        ></a
      >
      <nav aria-label="Main navigation">
        <a href="#services">Services</a><a href="#approach">Approach</a><a href="#work">Work</a><a
          href="#about">About</a
        ><a href="#contact">Contact</a>
      </nav>
      <a class="header-action" href="#contact" data-book>Book a call</a>
    </header>
    <main id="main">
      <section class="hero wrap" id="home" data-capture="hero">
        <div class="hero-copy">
          <p class="eyebrow">
            <span data-role>{c.role}</span> · <span data-hero-area>{c.area}</span>
          </p>
          <h1><span data-business>{c.name}</span></h1>
          <p class="tagline" data-copy="promise">{c.hero.tagline}</p>
          <p class="lead">{c.hero.description}</p>
          <div class="hero-actions">
            <a class="button accent" href="#contact" data-book data-capture="demo"
              >{c.hero.action} <span aria-hidden="true">→</span></a
            >
            <a class="text-link" href="#services">See how I can help</a>
          </div>
          <p class="small-note">{c.hero.note}</p>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="hero-portrait">
            <ConsultantArtwork kind="avatar" />
            <span>Your photo here</span>
          </div>
          <div class="signature-card">
            <span class="signature-mono" data-monogram>{c.monogram}</span>
            <svg class="signature-line" viewBox="0 0 300 60" focusable="false">
              <path pathLength="100" d="M6 40c30-30 50 12 76-6s34-24 50-4 40 18 70-8 50-10 92 6"
              ></path>
            </svg>
            <span class="signature-role" data-role>{c.role}</span>
          </div>
          <div class="hero-card">
            <span class="eyebrow"><span class="live-dot"></span>THIS WEEK · EXAMPLE</span>
            <strong>Free 15-minute calls</strong>
            <span>Tuesday and Thursday</span>
          </div>
        </div>
      </section>
      <section
        class="section wrap"
        id="services"
        data-capture="services"
        aria-labelledby="services-title"
      >
        <header class="section-heading" data-reveal>
          <p class="eyebrow">01 · HOW I CAN HELP</p>
          <h2 id="services-title">Ways to work <em>together.</em></h2>
          <p>Sample services and prices, ready to be replaced with your own.</p>
        </header>
        <div class="service-grid">
          {
            c.services.map((s, i) => (
              <a class="service-card" href="#contact" data-service={s.id}>
                <>
                  <span class="count">0{i + 1}</span>
                  <p class="eyebrow" data-copy={`services.${i}.type`}>
                    {s.type}
                  </p>
                  <h3 data-copy={`services.${i}.name`}>{s.name}</h3>
                  <p data-copy={`services.${i}.description`}>{s.description}</p>
                  <span class="price">
                    <>
                      <strong data-sample-price data-copy={`services.${i}.price`}>
                        {s.price}
                      </strong>
                      <span class="arrow" aria-hidden="true">
                        →
                      </span>
                    </>
                  </span>
                  <span class="small-note" data-copy={`services.${i}.detail`}>
                    {s.detail}
                  </span>
                </>
              </a>
            ))
          }
        </div>
        <div class="clients" data-reveal>
          <p class="eyebrow">WHO I WORK WITH · EXAMPLE</p>
          <ul>
            {c.clients.map((item, i) => <li data-copy={`clients.${i}`}>{item}</li>)}
          </ul>
        </div>
      </section>
      <section class="approach section" id="approach" aria-labelledby="approach-title">
        <div class="wrap">
          <header class="section-heading" data-reveal>
            <p class="eyebrow">02 · HOW IT WORKS</p>
            <h2 id="approach-title">From tangle <em>to clear line.</em></h2>
            <p>Scroll to see a messy problem become a plan.</p>
          </header>
          <div class="process-layout">
            <figure class="motion-stage" data-capture="motion">
              <div class="board-scene" data-board>
                <ConsultantArtwork kind="board" />
              </div>
              <p class="stage-caption" aria-hidden="true">
                <span data-stage-number>03</span>
                <span data-stage-caption>{c.process[2][0]}</span>
              </p>
              <div class="motion-progress" aria-hidden="true"><span></span></div>
              <figcaption class="small-note">
                An original illustration. No result is claimed.
              </figcaption>
            </figure>
            <ol class="process-steps">
              {
                c.process.map(([heading, text], i) => (
                  <li>
                    <>
                      <span class="step-number">0{i + 1}</span>
                      <div>
                        <>
                          <h3>{heading}</h3>
                          <p>{text}</p>
                        </>
                      </div>
                    </>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>
      <section class="section wrap" id="work" data-capture="gallery" aria-labelledby="work-title">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">03 · RECENT WORK</p>
          <h2 id="work-title">Problems, <em>untangled.</em></h2>
          <p>Example case studies. Your own client stories, with their permission, go here.</p>
        </header>
        <div class="case-grid">
          {
            c.cases.map((item, i) => (
              <article class="case-card" data-reveal>
                <>
                  <div class="case-art" data-case-art>
                    <ConsultantArtwork kind={item.kind} />
                    <span class="case-tag">Example case study</span>
                  </div>
                  <div class="case-copy">
                    <>
                      <p class="eyebrow" data-copy={`cases.${i}.sector`}>
                        {item.sector}
                      </p>
                      <h3 data-copy={`cases.${i}.title`}>{item.title}</h3>
                      <p>
                        <>
                          <strong>The problem:</strong>{' '}
                          <span data-copy={`cases.${i}.problem`}>{item.problem}</span>
                        </>
                      </p>
                      <p>
                        <>
                          <strong>Example outcome:</strong>{' '}
                          <span data-copy={`cases.${i}.outcome`}>{item.outcome}</span>
                        </>
                      </p>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </section>
      <section class="about section" id="about" aria-labelledby="about-title">
        <div class="wrap about-layout">
          <div class="portrait" data-portrait>
            <ConsultantArtwork kind="portrait" />
            <span class="portrait-label">Your photo here</span>
          </div>
          <div data-reveal>
            <p class="eyebrow">04 · ABOUT ME</p>
            <h2 id="about-title">Hello, I’m <span data-business>{c.name}</span>.</h2>
            {c.about.map((paragraph) => <p class="about-text">{paragraph}</p>)}
            <p class="small-note">Sample introduction. Your own story goes here.</p>
            <ul class="placeholders" aria-label="Placeholders for your details">
              <li>Your qualification here</li>
              <li>Your professional membership here</li>
              <li>Your insurance details here</li>
            </ul>
            <p class="eyebrow logos-title">CLIENT LOGOS · PLACEHOLDERS</p>
            <ul class="logo-row" aria-label="Client logo placeholders">
              {[1, 2, 3, 4].map(() => <li>Client logo</li>)}
            </ul>
          </div>
        </div>
      </section>
      <section class="reviews section" data-capture="reviews" aria-labelledby="reviews-title">
        <div class="wrap">
          <header class="section-heading" data-reveal>
            <p class="eyebrow">05 · KIND WORDS</p>
            <h2 id="reviews-title">What clients <em>say.</em></h2>
            <p>Example reviews — your real Google reviews appear here.</p>
          </header>
          <div class="review-grid">
            {
              c.reviews.map((r) => (
                <article class="review-card" data-sample-review data-reveal>
                  <>
                    <div class="review-top">
                      <>
                        <span class="avatar" aria-hidden="true">
                          {r.initials}
                        </span>
                        <div>
                          <>
                            <h3>{r.name}</h3>
                            <p class="review-date">{r.date}</p>
                          </>
                        </div>
                        <span class="review-tag">Example review</span>
                      </>
                    </div>
                    <p class="stars" role="img" aria-label="5 out of 5 stars (example)">
                      ★★★★★
                    </p>
                    <p>{r.text}</p>
                  </>
                </article>
              ))
            }
          </div>
        </div>
      </section>
      <section
        class="contact section"
        id="contact"
        data-capture="contact"
        aria-labelledby="contact-title"
      >
        <div class="wrap">
          <header class="section-heading" data-reveal>
            <p class="eyebrow">06 · LET’S TALK</p>
            <h2 id="contact-title">Start with <em>fifteen minutes.</em></h2>
            <p class="contact-line">
              <span data-business>{c.name}</span>{' · '}<span data-role>{c.role}</span>{' · '}<span
                data-area>{c.area}</span
              >
            </p>
          </header>
          <div class="details-grid">
            <div class="contact-card">
              <p class="eyebrow">FREE DISCOVERY CALL · DEMO</p>
              <h3>Talk it through, no obligation.</h3>
              <p>Try the booking journey. No call is booked and nothing is sent.</p>
              <div class="slot-calendar" data-calendar>
                <ConsultantArtwork kind="calendar" />
                <p class="small-note">Example free slots this week, Monday to Friday.</p>
              </div>
              <button class="button accent" type="button" data-book
                >Book a free 15-minute call <span aria-hidden="true">→</span></button
              >
              <div class="contact-actions">
                <a href="#contact" data-call>Call <span data-phone>Your number here</span></a><a
                  href="#contact"
                  data-whatsapp>WhatsApp <span data-phone>Your number here</span></a
                ><button type="button" data-directions>Directions</button>
              </div>
              <p class="small-note">
                Already use Calendly or Microsoft Bookings? We’ll connect it.
              </p>
            </div>
            <div class="hours">
              <h3>Availability</h3>
              <p class="small-note">Example working hours</p>
              <dl>
                {
                  c.hours.map(([day, hours]) => (
                    <div>
                      <>
                        <dt>{day}</dt>
                        <dd>{hours}</dd>
                      </>
                    </div>
                  ))
                }
              </dl>
            </div>
            <div class="map-card">
              <svg class="map-drawing" viewBox="0 0 360 200" aria-hidden="true" focusable="false">
                <rect width="360" height="200" class="f-brand-soft"></rect>
                <path d="M-10 140C90 110 170 170 370 90" class="s-paper" stroke-width="16"></path>
                <path d="M110-10 140 210M250-10l-30 220" class="s-paper" stroke-width="10"></path>
                <rect x="24" y="22" width="70" height="46" rx="8" class="f-accent-soft"></rect>
                <rect x="268" y="132" width="70" height="48" rx="8" class="f-accent-soft"></rect>
                <path
                  d="M190 50c-17 0-30 13-30 30 0 23 30 50 30 50s30-27 30-50c0-17-13-30-30-30Z"
                  class="f-brand"></path>
                <circle cx="190" cy="80" r="11" class="f-accent"></circle>
              </svg>
              <div class="map-copy">
                <p class="eyebrow">BASED IN</p>
                <h3 data-area>{c.area}</h3>
                <p class="small-note">
                  Your address here · meetings online or in person · map placeholder
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section wrap questions" aria-labelledby="questions-title">
        <div data-reveal>
          <p class="eyebrow">GOOD TO KNOW</p>
          <h2 id="questions-title">Questions, <em>answered.</em></h2>
        </div>
        <div data-reveal>
          {
            c.questions.map(([question, answer]) => (
              <details>
                <>
                  <summary>
                    {question}
                    <span aria-hidden="true">+</span>
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </section>
      <section class="agency-offer" aria-labelledby="offer-title">
        <div class="wrap offer-inner" data-reveal>
          <div>
            <p class="eyebrow">SIGNATURE / CONSULTANT-07 · BY FINTAXTECH</p>
            <h2 id="offer-title">Picture your business here? <em>We’ll make it yours.</em></h2>
            <p>A website for <span data-business>{c.name}</span>, shaped around your clients.</p>
          </div>
          <a class="button accent" href="/contact/" data-agency-link
            >Talk to FinTaxTech <span aria-hidden="true">→</span></a
          >
        </div>
      </section>
      <noscript
        ><p class="wrap">
          This is a demonstration website. Enable JavaScript to personalise the name or try the call
          booking. <a href="/contact/">Contact FinTaxTech about your website.</a>
        </p></noscript
      >
    </main>
    <footer class="wrap site-footer">
      <a class="brand" href="#home"
        ><span class="monogram" data-monogram aria-hidden="true">{c.monogram}</span><span
          ><span data-business>{c.name}</span><span class="footer-role" data-role>{c.role}</span
          ></span
        ></a
      >
      <p>
        A fictional professional, shown as a demonstration by FinTaxTech.<br />No calls, bookings,
        messages or payments are submitted.
      </p>
      <a href={motionGallery.route}>{motionGallery.backLabel} <span aria-hidden="true">↗</span></a>
    </footer>
    <div class="mobile-contact" aria-label="Example contact actions">
      <a href="#contact" data-call>Call</a><a href="#contact" data-book>Book a call</a>
    </div>
    <dialog id="name-dialog" aria-labelledby="name-title" aria-describedby="name-description">
      <button class="close" data-close type="button" aria-label="Close name dialog">×</button>
      <p class="eyebrow">YOUR NAME, YOUR WEBSITE</p>
      <h2 id="name-title">{c.nameDialog.title}</h2>
      <p id="name-description">{c.nameDialog.description}</p>
      <form id="name-form" novalidate>
        <label for="business-name">Your name or business name</label><input
          id="business-name"
          name="business"
          maxlength="100"
          placeholder="Sarah Reid"
          autocomplete="off"
          aria-describedby="name-hint name-error"
        />
        <p id="name-error" class="form-error" role="alert"></p>
        <p id="name-hint" class="small-note">
          Up to 100 characters. Kept only in this page and its URL.
        </p>
        <button class="button accent" type="submit"
          >Preview my website <span aria-hidden="true">→</span></button
        >
      </form>
      <div class="dialog-links">
        <button id="restore-name" class="text-button" type="button"
          >Explore the sample / restore default</button
        ><button id="copy-link" class="text-button" type="button">Copy your link</button>
      </div>
    </dialog>
    <dialog id="call-dialog" aria-labelledby="call-title" aria-describedby="call-intro">
      <button class="close" data-close type="button" aria-label="Close call booking demo">×</button>
      <p class="eyebrow">EXAMPLE BOOKING · NOTHING IS SENT</p>
      <h2 id="call-title">A free 15-minute call.</h2>
      <p id="call-intro">Try booking a discovery call with <span data-business>{c.name}</span>.</p>
      <ol class="flow-progress" aria-label="Booking steps">
        <li data-step-indicator>1. Topic</li><li data-step-indicator>2. Time</li><li
          data-step-indicator
        >
          3. Done
        </li>
      </ol>
      <form id="topic-form">
        <h3 tabindex="-1">01 / What would you like to talk about?</h3>
        <label for="call-topic">Topic</label><select id="call-topic"
          >{
            [...c.services.map((s) => s.id), 'chat'].map((id, i) => (
              <option value={id} data-copy={`topics.${i}`}>
                {c.flow.topics[i]}
              </option>
            ))
          }</select
        >
        <button class="button accent" type="submit"
          >Next: pick a time <span aria-hidden="true">→</span></button
        >
      </form>
      <form id="time-form" hidden>
        <h3 tabindex="-1">02 / Pick a sample day and time</h3>
        <p>Example times only. No name, email or phone number needed.</p>
        <label for="call-day">Day</label><select id="call-day"
          >{c.flow.days.map((day) => <option>{day}</option>)}</select
        ><label for="call-time">Time</label><select id="call-time"
          >{c.flow.times.map((time) => <option>{time}</option>)}</select
        >
        <button class="button accent" type="submit"
          >See my booking <span aria-hidden="true">→</span></button
        ><button class="text-button" type="button" data-restart>Back</button>
      </form>
      <div id="call-final" hidden>
        <h3 tabindex="-1">03 / Speak soon.</h3>
        <div class="booked-card">
          <svg class="booked-tick" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <circle cx="32" cy="32" r="28" class="f-accent"></circle>
            <path pathLength="100" d="M19 33l9 9 17-19"></path>
          </svg>
          <div>
            <p class="eyebrow">YOUR EXAMPLE SLOT</p>
            <p id="call-summary" class="call-summary"></p>
          </div>
        </div>
        <p>
          This is where clients would book a call. <strong>Demo only, nothing is booked.</strong>
        </p>
        <p>No call, payment or message is submitted.</p>
        <a class="button accent" href="/contact/" data-agency-link
          ><span>Want this for <span data-business>{c.name}</span>? Talk to FinTaxTech</span>
          <span aria-hidden="true">→</span></a
        ><button class="text-button" type="button" data-restart>Try another booking</button>
      </div>
    </dialog>
    <dialog id="contact-dialog" aria-labelledby="contact-dialog-title">
      <button class="close" data-close type="button" aria-label="Close contact preview">×</button>
      <p class="eyebrow">EXAMPLE CONTACT ACTION</p>
      <h2 id="contact-dialog-title">Contact preview</h2>
      <p data-business>{c.name}</p>
      <p id="contact-explanation"></p>
      <p class="contact-preview-value"></p>
      <a class="button accent" href="/contact/" data-agency-link
        >Discuss your website with FinTaxTech <span aria-hidden="true">→</span></a
      >
    </dialog>
    <p class="sr-only" id="announcement" role="status" aria-live="polite"></p>
    <script
      is:inline
      type="application/json"
      id="template-copy"
      set:html={JSON.stringify(c).replace(/</g, '\\u003c')}
    />
    <script is:inline src="/templates/website/motion/consultant-07/app.js"></script>
    <script is:inline src="/templates/website/motion/consultant-07/motion.js" defer></script>
  </body>
</html>
