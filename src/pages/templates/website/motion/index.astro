---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { motionFaqs, motionSteps, motionTrades } from '../../../../content/motion-catalogue';
import TemplateCard from '../../../../components/templates/TemplateCard.astro';
import { motionGallery as c, motionTemplates, threeDGallery } from '../../../../content/templates';
---

<SiteLayout title={c.title} description={c.description}>
  <div class="container">
    <header class="page-head">
      <h1>{c.title}</h1>
      <p class="lead">{c.intro}</p>
    </header>
    <ul class="template-grid" role="list">
      {
        motionTemplates.map((template) => (
          <li>
            <TemplateCard template={template} />
          </li>
        ))
      }
    </ul>
    <div class="gallery-note prose">
      {
        motionTemplates.map((template) => (
          <section>
            <h2>{motionTrades[template.id].heading}</h2>
            <p>{motionTrades[template.id].intro}</p>
            <a href={template.route} data-template-preview>
              Preview {template.name}
            </a>
          </section>
        ))
      }
      <section aria-labelledby="motion-how">
        <h2 id="motion-how">How it works</h2>
        <ol class="steps">
          {
            motionSteps.map(([title, detail]) => (
              <li>
                <>
                  <strong>{title}</strong>
                  <p>{detail}</p>
                </>
              </li>
            ))
          }
        </ol>
      </section>
      <section aria-labelledby="motion-faq">
        <h2 id="motion-faq">Frequently asked questions</h2>
        {
          motionFaqs.map(({ question, answer }) => (
            <details>
              <>
                <summary>{question}</summary>
                <p>{answer}</p>
              </>
            </details>
          ))
        }
      </section>
      <section>
        <h2>Explore more examples</h2>
        <ul>
          <li><a href={threeDGallery.route}>Explore 3D website templates</a></li>
          <li><a href="/showcase/garage/">See the garage showcase</a></li>
          <li><a href="/showcase/plumbing/">See the plumbing showcase</a></li>
        </ul>
        <a class="button primary" href="/start/">Start your project</a>
      </section>
      <p class="muted">{c.note}</p>
      <a class="button primary" href="/contact/">{c.contactLabel}</a>
    </div>
  </div>
</SiteLayout>

<style>
  .template-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  li {
    min-width: 0;
    margin: 0;
  }
  .gallery-note {
    padding-block: var(--space-7) var(--space-9);
  }
  @media (--tablet) {
    .template-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
