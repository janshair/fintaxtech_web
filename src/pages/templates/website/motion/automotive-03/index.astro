---
import { templateTheme } from '../../../../../lib/template-theme';
import { THEME, automotiveDemo as c } from '../../../../../content/automotive-demo';
import { motionTemplates, motionGallery } from '../../../../../content/templates';
import { seoPages } from '../../../../../content/seo';
import { absoluteURL, structuredData } from '../../../../../lib/seo';
import AutomotiveArtwork from '../../../../../components/templates/AutomotiveArtwork.astro';
const template = motionTemplates.find((item) => item.id === c.id)!;
const { title, description } = seoPages[c.route];
const canonical = absoluteURL(c.route);
const image = absoluteURL(template.preview.src);
const theme = templateTheme('automotive-03', THEME);
---

<!doctype html>
<html lang="en" style={theme.style} data-custom-theme={theme.custom || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={theme.pageBackground} />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/mark.svg" />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} /><meta
      property="og:image:alt"
      content={template.preview.alt}
    />
    <meta property="og:image:width" content={String(template.preview.width)} /><meta
      property="og:image:height"
      content={String(template.preview.height)}
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    />
    <meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={image}
    /><meta name="twitter:image:alt" content={template.preview.alt} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData(c.route, title, description)).replace(
        /</g,
        '\\u003c',
      )}
    />
    <link rel="stylesheet" href="/templates/website/motion/automotive-03/styles.css" />
  </head>
  <body>
    <svg class="road-spine" aria-hidden="true" focusable="false"
      ><path pathLength="1" fill="none"></path></svg
    >
    <a class="skip" href="#main">{c.skip}</a>
    <aside class="demo-strip">
      <a href="/" class="agency">{c.agency}<span aria-hidden="true">↗</span></a>
      <span class="demo-id">{c.demoLabel}</span>
      <a class="gallery-link" href={motionGallery.route}>{c.gallery}</a>
      <a class="agency-contact strip-contact" href={c.contact}>{c.enquire}</a>
      <button type="button" data-edit>{c.edit}</button>
    </aside>
    <header class="garage-header wrap">
      <a class="brand" href="#home"
        ><span class="monogram" data-monogram aria-hidden="true">{c.monogram}</span><span
          data-business>{c.name}</span
        ></a
      >
      <button class="menu-toggle" type="button" aria-controls="navigation" aria-expanded="false"
        >{c.menu}<span aria-hidden="true">＋</span></button
      >
      <nav id="navigation" aria-label={c.navLabel}>
        {c.nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" id="home">
        <div class="hero-copy">
          <p class="eyebrow">{c.hero.eyebrow}</p>
          <p class="hero-identity">
            <span data-business>{c.name}</span><span data-hero-area hidden></span>
          </p>
          <h1>
            <span class="headline-mask"><span>{c.hero.first}</span></span><span
              class="headline-mask"><span>{c.hero.second}</span></span
            >
          </h1>
          <p class="lead">{c.hero.description}</p>
          <div class="hero-actions">
            <a class="button" href="#quote" data-quote>{c.quote}<span aria-hidden="true">↗</span></a
            ><a class="text-link" href="#services"
              >{c.hero.secondary}<span aria-hidden="true">↓</span></a
            >
          </div>
          <p class="small-note">{c.hero.note}</p>
        </div>
        <div class="hero-art">
          <div class="art-topline">
            <span class="technical-label">{c.hero.artCaption}</span><span
              class="art-cross"
              aria-hidden="true">＋</span
            >
          </div>
          <AutomotiveArtwork kind="car" label={c.hero.artLabel} id="hero-car" />
          <div class="hero-road" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="technical-label art-caption">{c.hero.artDetail}</p>
        </div>
      </section>
      <section class="services paper section" id="services" aria-labelledby="services-title">
        <div class="wrap">
          <header class="section-heading">
            <p class="eyebrow">{c.services.eyebrow}</p><h2 id="services-title">
              {c.services.title}
            </h2><p>{c.services.intro}</p>
          </header>
          <div class="service-grid">
            {
              c.services.items.map((service, i) => (
                <a class="service-row" href="#quote" data-service={service.code}>
                  <>
                    <span class="service-number" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="service-tag">{service.label}</span>
                    <h3>{service.name}</h3>
                    <p>{service.description}</p>
                    <span class="service-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </>
                </a>
              ))
            }
          </div><p class="small-note service-note">{c.services.note}</p>
        </div>
      </section>
      <section class="workshop" id="workshop" aria-labelledby="workshop-title">
        <div class="workshop-sticky wrap">
          <header>
            <p class="eyebrow">{c.process.eyebrow}</p><h2 id="workshop-title">
              {c.process.title}
            </h2><p>{c.process.intro}</p>
          </header>
          <div class="workshop-stage">
            <AutomotiveArtwork kind="car" label={c.process.artLabel} id="workshop-car" /><p
              class="technical-label"
            >
              {c.process.caption}
            </p>
          </div>
          <ol class="steps">
            {
              c.process.steps.map(([title, body], i) => (
                <li>
                  <>
                    <span class="step-number" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <h3>{title}</h3>
                    <p>{body}</p>
                  </>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
      <section class="work section wrap" id="details" aria-labelledby="work-title">
        <header class="section-heading">
          <p class="eyebrow">{c.work.eyebrow}</p><h2 id="work-title">{c.work.title}</h2><p>
            {c.work.intro}
          </p>
        </header>
        <div class="work-grid">
          {
            c.work.items.map((item, i) => (
              <figure>
                <div class="part-frame">
                  <>
                    <AutomotiveArtwork kind={item.kind} label={item.alt} id={`part-${i}`} />
                    <span class="part-corner" aria-hidden="true">
                      ＋
                    </span>
                  </>
                </div>
                <figcaption>
                  <>
                    <span class="work-state" data-work-state>
                      {c.work.after}
                    </span>
                    <h3>{item.title}</h3>
                    <p>{item.caption}</p>
                  </>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>
      <section class="reviews section wrap" aria-labelledby="reviews-title">
        <h2 id="reviews-title">{c.reviews.title}</h2><p>{c.reviews.intro}</p><div
          class="review-grid"
        >
          {
            Array.from({ length: 3 }, () => (
              <p>
                <span aria-hidden="true">“</span>
                {c.reviews.placeholder}
              </p>
            ))
          }
        </div>
      </section>
      <section class="visit paper section" id="visit" aria-labelledby="visit-title">
        <div class="wrap visit-grid">
          <div>
            <p class="eyebrow">{c.visit.eyebrow}</p><h2 id="visit-title">{c.visit.title}</h2><p>
              {c.visit.intro}
            </p><div id="quote">
              <a class="button" href="#quote-details" data-quote
                >{c.quote}<span aria-hidden="true">↗</span></a
              ><p class="small-note">{c.visit.tools}</p>
            </div>
          </div>
          <div id="quote-details">
            <h3>{c.practical.title}</h3>{
              c.practical.items.map(([title, answer]) => (
                <details>
                  <>
                    <summary>{title}</summary>
                    <p>{answer}</p>
                  </>
                </details>
              ))
            }
          </div>
        </div>
        <div class="wrap contact-grid" id="contact-details">
          <div class="contact-info">
            <h3>{c.visit.contactLabel}</h3><p class="phone-number" data-phone-text>
              {c.visit.phone}
            </p><div class="contact-actions">
              <a href="#contact-details" data-call
                >{c.visit.call}<span aria-hidden="true">↗</span></a
              ><a href="#contact-details" data-whatsapp
                >{c.visit.whatsapp}<span aria-hidden="true">↗</span></a
              ><a href="#map" data-directions
                >{c.visit.directions}<span aria-hidden="true">↗</span></a
              >
            </div><h3>{c.visit.hoursLabel}</h3><dl>
              {
                c.visit.hours.map(([day, hours]) => (
                  <div>
                    <>
                      <dt>{day}</dt>
                      <dd>{hours}</dd>
                    </>
                  </div>
                ))
              }
            </dl><p class="small-note">{c.visit.sampleNote}</p>
          </div>
          <div class="map" id="map">
            <svg class="map-lines" viewBox="0 0 500 320" aria-hidden="true"
              ><path d="M-30 80 530 220M180-30 350 350M-20 270 520 60M80-20 150 340"></path><circle
                cx="260"
                cy="160"
                r="44"></circle></svg
            ><span class="map-pin" aria-hidden="true">⌖</span><h3>{c.visit.locationLabel}</h3><p
              class="map-area"
              data-area
            >
              {c.visit.location}
            </p><p>{c.visit.mapNote}</p>
          </div>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <a class="brand" href="#home"
        ><span class="monogram" data-monogram aria-hidden="true">{c.monogram}</span><span
          data-business>{c.name}</span
        ></a
      ><p>{c.footer}</p><a href={motionGallery.route}>{c.gallery} ↗</a>
    </footer>
    <aside class="agency-offer wrap">
      <svg class="offer-line" aria-hidden="true"
        ><rect x="8" y="8" width="100%" height="100%" pathLength="1" fill="none"></rect></svg
      ><p>{c.offer}<span>{c.offerDetail}</span></p><a class="button agency-contact" href={c.contact}
        >{c.offerAction}<span aria-hidden="true">↗</span></a
      >
    </aside>
    <aside class="mobile-actions" aria-label={c.visit.contactLabel}>
      <a href="#contact-details" data-call>{c.visit.call}</a><a href="#quote" data-quote
        >{c.quote}<span aria-hidden="true">↗</span></a
      >
    </aside>
    <dialog id="name-dialog" aria-labelledby="name-title" aria-describedby="name-description">
      <button class="close" type="button" data-close aria-label={c.close}>×</button><p
        class="eyebrow"
      >
        {c.demoLabel}
      </p><h2 id="name-title">{c.nameDialog.title}</h2><p id="name-description">
        {c.nameDialog.description}
      </p><form id="name-form" autocomplete="off">
        <label for="business-name">{c.nameDialog.label}</label><input
          id="business-name"
          type="text"
          maxlength="100"
          required
          placeholder={c.nameDialog.placeholder}
          autocomplete="off"
        /><p class="small-note">{c.nameDialog.hint}</p><button class="button" type="submit"
          >{c.nameDialog.submit}<span aria-hidden="true">↗</span></button
        >
      </form><button type="button" class="plain" id="restore-name">{c.nameDialog.reset}</button>
    </dialog>
    <dialog id="quote-dialog" aria-labelledby="quote-title">
      <button class="close" type="button" data-close aria-label={c.close}>×</button><p
        class="eyebrow"
      >
        {c.request.label}
      </p><h2 id="quote-title">{c.request.title}</h2><p>
        {c.request.description}<span data-business>{c.name}</span>.
      </p>
      <div class="quote-progress" aria-hidden="true"><span></span></div>
      <form id="service-form">
        <h3>{c.request.serviceTitle}</h3><label for="quote-service">{c.request.serviceLabel}</label
        ><select id="quote-service"
          >{c.services.items.map((item) => <option value={item.code}>{item.name}</option>)}</select
        ><button class="button" type="submit"
          >{c.request.next}<span aria-hidden="true">↗</span></button
        >
      </form>
      <form id="car-form" hidden autocomplete="off" novalidate>
        <h3 tabindex="-1">{c.request.detailsTitle}</h3><p id="car-note">{c.request.note}</p><label
          for="sample-registration">{c.request.registrationLabel}</label
        ><input
          id="sample-registration"
          type="text"
          maxlength="10"
          required
          autocomplete="off"
          spellcheck="false"
          placeholder={c.request.registrationExample}
          aria-describedby="car-note registration-error"
          pattern="[A-Za-z0-9 ]{2,10}"
        /><p id="registration-error" class="form-error" role="alert" hidden>
          {c.request.registrationError}
        </p><label for="preferred-day">{c.request.dayLabel}</label><select
          id="preferred-day"
          required
          >{
            c.request.days.map((day, index) => (
              <option selected={index === c.request.days.length - 1}>{day}</option>
            ))
          }</select
        ><button class="button" type="submit"
          >{c.request.confirm}<span aria-hidden="true">↗</span></button
        ><button type="button" class="plain" data-restart>{c.request.back}</button>
      </form>
      <div id="quote-final" hidden>
        <svg class="confirmation-mark" width="48" height="40" viewBox="0 0 48 40" aria-hidden="true"
          ><path
            pathLength="1"
            d="m5 20 12 12L42 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"></path></svg
        ><h3 tabindex="-1">{c.request.finalTitle}</h3><p id="quote-summary"></p><p
          class="demo-result"
        >
          {c.request.final}
        </p><p class="small-note">{c.request.finalNote}</p><a
          class="button final-offer agency-contact"
          href={c.contact}>{c.offerBefore}<span data-business>{c.name}</span>{c.offerAfter}</a
        ><button type="button" class="plain" data-restart>{c.request.restart}</button>
      </div>
    </dialog>
    <p id="announcement" class="sr-only" aria-live="polite"></p>
    <noscript
      ><p class="wrap no-script">{c.noScript} <a href={c.contact}>{c.offerAction}</a></p></noscript
    >
    <script
      id="template-copy"
      type="application/json"
      is:inline
      set:html={JSON.stringify(c).replace(/</g, '\\u003c')}
    />
    <script is:inline src="/templates/website/motion/automotive-03/app.js"></script>
    <script is:inline src="/templates/website/motion/automotive-03/motion.js"></script>
  </body>
</html>
