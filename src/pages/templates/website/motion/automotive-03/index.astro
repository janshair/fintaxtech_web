---
import { templateTheme } from '../../../../../lib/template-theme';
import { THEME, PRICES, automotiveDemo as c } from '../../../../../content/automotive-demo';
import { motionTemplates, motionGallery, templateSocial } from '../../../../../content/templates';
import { seoPages } from '../../../../../content/seo';
import { absoluteURL, structuredData } from '../../../../../lib/seo';
import AutomotiveArtwork from '../../../../../components/templates/AutomotiveArtwork.astro';
const template = motionTemplates.find((item) => item.id === c.id)!;
const { title, description } = seoPages[c.route];
const canonical = absoluteURL(c.route);
// Neutral link preview: crawlers ignore ?name=, so it names no business.
const social = templateSocial(template);
const image = absoluteURL(social.image);
const theme = templateTheme('automotive-03', THEME);
// Links for the example number; app.js swaps in ?phone= when given.
const examplePhone = '44' + c.visit.phone.replace(/\D/g, '').slice(1);
---

<!doctype html>
<html lang="en" style={theme.style} data-custom-theme={theme.custom || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={theme.pageBackground} />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/mark.svg" />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={social.description}
    />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} /><meta
      property="og:image:alt"
      content={social.alt}
    />
    <meta property="og:image:width" content={String(social.width)} /><meta
      property="og:image:height"
      content={String(social.height)}
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    />
    <meta name="twitter:description" content={social.description} /><meta
      name="twitter:image"
      content={image}
    /><meta name="twitter:image:alt" content={social.alt} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData(c.route, title, description)).replace(
        /</g,
        '\\u003c',
      )}
    />
    <link rel="stylesheet" href="/templates/website/motion/automotive-03/styles.css" />
  </head>
  <body>
    <svg class="road-spine" aria-hidden="true" focusable="false"
      ><path pathLength="1" fill="none"></path></svg
    >
    <a class="skip" href="#main">{c.skip}</a>
    <aside class="demo-strip">
      <a href="/" class="agency">{c.agency}<span aria-hidden="true">↗</span></a>
      <span class="demo-id">{c.demoLabel}</span>
      <a class="gallery-link" href={motionGallery.route}>{c.gallery}</a>
      <a class="agency-contact strip-contact" href={c.contact}>{c.enquire}</a>
      <button type="button" data-edit>{c.edit}</button>
    </aside>
    <header class="garage-header wrap">
      <a class="brand" href="#home"
        ><span class="monogram" data-monogram aria-hidden="true">{c.monogram}</span><span
          data-business>{c.name}</span
        ></a
      >
      <button class="menu-toggle" type="button" aria-controls="navigation" aria-expanded="false"
        >{c.menu}<span aria-hidden="true">＋</span></button
      >
      <nav id="navigation" aria-label={c.navLabel}>
        {c.nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" id="home">
        <div class="hero-copy">
          <p class="eyebrow">{c.hero.eyebrow}</p>
          <h1 class="hero-identity">
            <span class="headline-mask"><span data-business>{c.name}</span></span>
          </h1>
          <p class="lead">{c.hero.before}<span data-town>{c.area}</span>{c.hero.after}</p>
          <div class="hero-actions">
            <a class="button" href="#mot" data-hero-mot
              >{c.hero.mot}<span aria-hidden="true">↓</span></a
            ><a class="button button-outline" href="#quote" data-quote
              >{c.hero.quote}<span aria-hidden="true">↓</span></a
            >
          </div>
          <p class="small-note">{c.hero.note}</p>
        </div>
        <div class="hero-art">
          <div class="art-topline">
            <span class="technical-label">{c.hero.artCaption}</span><span
              class="art-cross"
              aria-hidden="true">＋</span
            >
          </div>
          <AutomotiveArtwork kind="car" label={c.hero.artLabel} id="hero-car" />
          <div class="hero-road" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="technical-label art-caption">{c.hero.artDetail}</p>
        </div>
      </section>
      <section class="trust-strip" aria-label={c.trustLabel}>
        <ul class="wrap trust-list">
          {
            c.trust.map((item) => (
              <li>
                <>
                  <span class="trust-mark" aria-hidden="true">
                    ✓
                  </span>
                  {item}
                </>
              </li>
            ))
          }
        </ul>
        <!-- Accreditation logo slots stay hidden unless switched on in
             src/content/automotive-demo.ts (accreditations: show: true).
             Only switch one on if the garage really holds that membership. -->
        <ul
          class="wrap accreditations"
          aria-label={c.accreditationsLabel}
          hidden={!c.accreditations.some((item) => item.show)}
        >
          {
            c.accreditations.map((item) => (
              <li class="accreditation-slot" hidden={!item.show}>
                {item.name}
              </li>
            ))
          }
        </ul>
      </section>
      <section class="services paper section" id="services" aria-labelledby="services-title">
        <div class="wrap">
          <header class="section-heading">
            <p class="eyebrow">{c.services.eyebrow}</p><h2 id="services-title">
              {c.services.title}
            </h2><p>{c.services.intro}</p>
          </header>
          <div class="service-grid">
            {
              c.services.items.slice(0, 6).map((service, i) => (
                <a class="service-row" href="#quote" data-service={service.code}>
                  <>
                    <span class="service-number" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {'badge' in service && <span class="service-badge">{service.badge}</span>}
                    <h3>{service.name}</h3>
                    <p class="service-price">{service.price}</p>
                    <p>{service.description}</p>
                    <span class="service-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </>
                </a>
              ))
            }
          </div>
          <div class="repairs">
            <h3 id="repairs-title">{c.services.repairsTitle}</h3>
            <ul class="repair-list" aria-labelledby="repairs-title">
              {
                c.services.items.slice(6).map((service, i) => (
                  <li>
                    <a
                      class="repair-row"
                      href="#quote"
                      data-service={service.code}
                      data-repair={service.repair ? '' : undefined}
                    >
                      <>
                        <span class="service-number" aria-hidden="true">
                          {String(i + 7).padStart(2, '0')}
                        </span>
                        <span class="repair-name">{service.name}</span>
                        <span class="repair-note">{service.description}</span>
                        <span class="service-price">{service.price}</span>
                        <span class="service-arrow" aria-hidden="true">
                          ↗
                        </span>
                      </>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div><p class="small-note service-note">{c.services.note}</p>
        </div>
      </section>
      <section class="mot section" id="mot" aria-labelledby="mot-title">
        <div class="wrap mot-grid">
          <div class="mot-intro">
            <p class="eyebrow">{c.mot.eyebrow}</p><h2 id="mot-title">{c.mot.title}</h2><p
              class="mot-approval"
            >
              {c.mot.approval}
            </p><p class="mot-price">
              <span>{c.mot.priceLabel}</span><strong>{PRICES.mot}</strong>
            </p><h3>{c.mot.checkedTitle}</h3><ul class="mot-checks">
              {c.mot.checked.map((item) => <li>{item}</li>)}
            </ul><p class="mot-retest">
              <strong>{c.mot.retest}</strong><span class="small-note">{c.mot.retestNote}</span>
            </p><a class="button" href="#quote" data-service="mot"
              >{c.mot.book}<span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="mot-reminder">
            <h3 id="reminder-title">{c.mot.reminder.title}</h3><p>{c.mot.reminder.intro}</p><form
              id="reminder-form"
              aria-labelledby="reminder-title"
              autocomplete="off"
              novalidate
            >
              <label for="reminder-plate">{c.mot.reminder.plateLabel}</label><span class="plate"
                ><input
                  id="reminder-plate"
                  class="plate-input"
                  type="text"
                  maxlength="8"
                  required
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  placeholder={c.quote.platePlaceholder}
                  aria-describedby="reminder-plate-error"
                /></span
              ><p id="reminder-plate-error" class="form-error" role="alert" hidden>
                {c.quote.errors.plate}
              </p><label for="reminder-phone">{c.mot.reminder.phoneLabel}</label><input
                id="reminder-phone"
                type="tel"
                inputmode="tel"
                maxlength="20"
                required
                autocomplete="tel"
                aria-describedby="reminder-phone-error"
              /><p id="reminder-phone-error" class="form-error" role="alert" hidden>
                {c.quote.errors.phone}
              </p><button class="button" type="submit"
                >{c.mot.reminder.submit}<span aria-hidden="true">↗</span></button
              ><p class="small-note">{c.quote.demoNote}</p>
            </form>
            <div id="reminder-thanks" class="form-thanks" hidden>
              <p class="demo-result" tabindex="-1">{c.mot.reminder.thanks}</p><p class="small-note">
                {c.quote.demoNote}
              </p><button type="button" class="plain" data-reminder-again
                >{c.mot.reminder.again}</button
              >
            </div>
          </div>
        </div>
      </section>
      <section class="workshop" id="workshop" aria-labelledby="workshop-title">
        <div class="workshop-sticky wrap">
          <header>
            <p class="eyebrow">{c.process.eyebrow}</p><h2 id="workshop-title">
              {c.process.title}
            </h2><p>{c.process.intro}</p>
          </header>
          <div class="workshop-stage">
            <AutomotiveArtwork kind="car" label={c.process.artLabel} id="workshop-car" /><p
              class="technical-label"
            >
              {c.process.caption}
            </p>
          </div>
          <ol class="steps">
            {
              c.process.steps.map(([title, body], i) => (
                <li>
                  <>
                    <span class="step-number" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <h3>{title}</h3>
                    <p>{body}</p>
                  </>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
      <section class="work section wrap" id="details" aria-labelledby="work-title">
        <header class="section-heading">
          <p class="eyebrow">{c.work.eyebrow}</p><h2 id="work-title">{c.work.title}</h2><p>
            {c.work.intro}
          </p>
        </header>
        <div class="work-grid">
          {
            c.work.items.map((item, i) => (
              <figure>
                <div class="part-frame">
                  <>
                    <AutomotiveArtwork kind={item.kind} label={item.alt} id={`part-${i}`} />
                    <span class="part-corner" aria-hidden="true">
                      ＋
                    </span>
                  </>
                </div>
                <figcaption>
                  <>
                    <span class="work-state" data-work-state>
                      {c.work.after}
                    </span>
                    <h3>{item.title}</h3>
                    <p>{item.caption}</p>
                  </>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>
      <section class="reviews section wrap" aria-labelledby="reviews-title">
        <h2 id="reviews-title">{c.reviews.title}</h2><p>{c.reviews.intro}</p><div
          class="review-grid"
        >
          {
            c.reviews.items.map((review) => (
              <figure class="review">
                <>
                  <p class="review-label">{c.reviews.label}</p>
                  <p class="review-stars" role="img" aria-label="5 out of 5 stars">
                    ★★★★★
                  </p>
                  <blockquote>
                    <p>{review.text}</p>
                  </blockquote>
                  <figcaption>{review.name}</figcaption>
                </>
              </figure>
            ))
          }
        </div>
      </section>
      <section class="visit paper section" id="quote" aria-labelledby="quote-title">
        <div class="wrap visit-grid quote-grid">
          <div class="quote-head">
            <p class="eyebrow">{c.quote.eyebrow}</p><h2 id="quote-title">{c.quote.title}</h2><p>
              {c.quote.intro}
            </p><p class="quote-call">
              {c.quote.call}<a href={`tel:+${examplePhone}`} data-call
                ><span data-phone-text>{c.visit.phone}</span><span aria-hidden="true">↗</span></a
              >
            </p>
          </div>
          <div class="quote-card">
            <form id="quote-form" aria-labelledby="quote-title" novalidate>
              <label for="quote-plate">{c.quote.plateLabel}</label><span class="plate"
                ><input
                  id="quote-plate"
                  class="plate-input"
                  type="text"
                  maxlength="8"
                  required
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  placeholder={c.quote.platePlaceholder}
                  aria-describedby="quote-plate-error"
                /></span
              ><p id="quote-plate-error" class="form-error" role="alert" hidden>
                {c.quote.errors.plate}
              </p><label for="quote-service">{c.quote.serviceLabel}</label><select
                id="quote-service"
                >{
                  c.services.items.map((item) => <option value={item.code}>{item.name}</option>)
                }</select
              ><label for="quote-date">{c.quote.dateLabel}</label><input
                id="quote-date"
                type="date"
              /><label for="quote-name">{c.quote.nameLabel}</label><input
                id="quote-name"
                type="text"
                maxlength="80"
                required
                autocomplete="name"
                aria-describedby="quote-name-error"
              /><p id="quote-name-error" class="form-error" role="alert" hidden>
                {c.quote.errors.name}
              </p><label for="quote-phone">{c.quote.phoneLabel}</label><input
                id="quote-phone"
                type="tel"
                inputmode="tel"
                maxlength="20"
                required
                autocomplete="tel"
                aria-describedby="quote-phone-error"
              /><p id="quote-phone-error" class="form-error" role="alert" hidden>
                {c.quote.errors.phone}
              </p><button class="button" type="submit"
                >{c.quote.submit}<span aria-hidden="true">↗</span></button
              ><p class="small-note">{c.quote.demoNote}</p>
            </form>
            <div id="quote-final" class="form-thanks" hidden>
              <svg
                class="confirmation-mark"
                width="48"
                height="40"
                viewBox="0 0 48 40"
                aria-hidden="true"
                ><path
                  pathLength="1"
                  d="m5 20 12 12L42 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"></path></svg
              ><h3 tabindex="-1">{c.quote.thanksTitle}</h3><p class="demo-result">
                {c.quote.thanks}
              </p><p id="quote-summary"></p><p class="small-note">{c.quote.demoNote}</p><a
                class="button final-offer"
                href="/client/website-brief/templates/?template=automotive-03"
                data-brief-link>{c.offerBefore}<span data-business>{c.name}</span>{c.offerAfter}</a
              ><a class="text-link brief-contact agency-contact" href={c.contact}
                >Or ask FinTaxTech a question first</a
              ><button type="button" class="plain" data-restart>{c.quote.again}</button>
            </div>
          </div>
          <div class="quote-more">
            <div class="quote-faq">
              <h3>{c.practical.title}</h3>{
                c.practical.items.map(([title, answer]) => (
                  <details>
                    <>
                      <summary>{title}</summary>
                      <p>{answer}</p>
                    </>
                  </details>
                ))
              }
            </div><p class="small-note quote-tools">{c.quote.tools}</p>
          </div>
        </div>
      </section>
      <section class="visit visit-info paper section" id="visit" aria-labelledby="visit-title">
        <div class="wrap">
          <header class="section-heading">
            <p class="eyebrow">{c.visit.eyebrow}</p><h2 id="visit-title">{c.visit.title}</h2>
          </header>
        </div>
        <div class="wrap contact-grid" id="contact-details">
          <div class="contact-info">
            <h3>{c.visit.contactLabel}</h3><p class="phone-number" data-phone-text>
              {c.visit.phone}
            </p><div class="contact-actions">
              <a href={`tel:+${examplePhone}`} data-call
                >{c.visit.call}<span aria-hidden="true">↗</span></a
              ><a href={`https://wa.me/${examplePhone}`} data-whatsapp
                >{c.visit.whatsapp}<span aria-hidden="true">↗</span></a
              ><a href="#map" data-directions
                >{c.visit.directions}<span aria-hidden="true">↗</span></a
              >
            </div><h3>{c.visit.hoursLabel}</h3><dl>
              {
                c.visit.hours.map(([day, hours]) => (
                  <div>
                    <>
                      <dt>{day}</dt>
                      <dd>{hours}</dd>
                    </>
                  </div>
                ))
              }
            </dl><p class="drop-off">{c.visit.dropOff}</p><p class="small-note">
              {c.visit.sampleNote}
            </p>
          </div>
          <div class="map" id="map">
            <svg class="map-lines" viewBox="0 0 500 320" aria-hidden="true"
              ><path d="M-30 80 530 220M180-30 350 350M-20 270 520 60M80-20 150 340"></path><circle
                cx="260"
                cy="160"
                r="44"></circle></svg
            ><span class="map-pin" aria-hidden="true">⌖</span><h3>{c.visit.locationLabel}</h3><p
              class="map-area"
            >
              {c.visit.address}, <span data-town>{c.area}</span>
            </p><p>{c.visit.mapNote}</p><button type="button" class="map-load" data-map-load hidden
              >{c.visit.showMap}</button
            ><p class="small-note map-privacy" hidden>{c.visit.mapPrivacy}</p>
          </div>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <a class="brand" href="#home"
        ><span class="monogram" data-monogram aria-hidden="true">{c.monogram}</span><span
          data-business>{c.name}</span
        ></a
      ><p>{c.footer}</p><a href={motionGallery.route}>{c.gallery} ↗</a>
    </footer>
    <aside class="agency-offer wrap">
      <svg class="offer-line" aria-hidden="true"
        ><rect x="8" y="8" width="100%" height="100%" pathLength="1" fill="none"></rect></svg
      ><p>{c.offer}<span>{c.offerDetail}</span></p><a class="button agency-contact" href={c.contact}
        >{c.offerAction}<span aria-hidden="true">↗</span></a
      >
    </aside>
    <aside class="mobile-actions" aria-label={c.visit.contactLabel}>
      <a href={`tel:+${examplePhone}`} data-call>{c.visit.call}</a><a
        href={`https://wa.me/${examplePhone}`}
        data-whatsapp>{c.visit.whatsapp}<span aria-hidden="true">↗</span></a
      >
    </aside>
    <dialog id="name-dialog" aria-labelledby="name-title" aria-describedby="name-description">
      <button class="close" type="button" data-close aria-label={c.close}>×</button><p
        class="eyebrow"
      >
        {c.demoLabel}
      </p><h2 id="name-title">{c.nameDialog.title}</h2><p id="name-description">
        {c.nameDialog.description}
      </p><form id="name-form" autocomplete="off">
        <label for="business-name">{c.nameDialog.label}</label><input
          id="business-name"
          type="text"
          maxlength="100"
          required
          placeholder={c.nameDialog.placeholder}
          autocomplete="off"
        /><p class="small-note">{c.nameDialog.hint}</p><button class="button" type="submit"
          >{c.nameDialog.submit}<span aria-hidden="true">↗</span></button
        >
      </form><button type="button" class="plain" id="restore-name">{c.nameDialog.reset}</button>
    </dialog>
    <p id="announcement" class="sr-only" aria-live="polite"></p>
    <noscript
      ><p class="wrap no-script">{c.noScript} <a href={c.contact}>{c.offerAction}</a></p></noscript
    >
    <script
      id="template-copy"
      type="application/json"
      is:inline
      set:html={JSON.stringify(c).replace(/</g, '\\u003c')}
    />
    <script is:inline src="/templates/website/motion/automotive-03/app.js"></script>
    <script is:inline src="/templates/website/motion/automotive-03/motion.js"></script>
  </body>
</html>
