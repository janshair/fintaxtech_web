---
import { templateTheme } from '../../../../../lib/template-theme';
import { seoPages, seoCopy } from '../../../../../content/seo';
import { structuredData, absoluteURL } from '../../../../../lib/seo';
import { THEME, barberDemo as c } from '../../../../../content/barber-demo';
import BarberCutIllustration from '../../../../../components/templates/BarberCutIllustration.astro';
import { motionGallery } from '../../../../../content/templates';
import { referenceCodes, visitEndpoint } from '../../../../../lib/barber-visits';
const visitConfig = {
  endpoint: visitEndpoint(import.meta.env.PUBLIC_BARBER_VISIT_ENDPOINT || ''),
  codes: referenceCodes(import.meta.env.PUBLIC_BARBER_REF_CODES || '').join(','),
};
const path = '/templates/website/motion/barber-01/';
const { title, description } = seoPages[path];
const canonical = absoluteURL(path);
const image = absoluteURL('/social.png');
const theme = templateTheme('barber-01', THEME);
---

<!doctype html>
<html lang="en" style={theme.style} data-custom-theme={theme.custom || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={theme.pageBackground} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23171916'/%3E%3Cpath d='M22 12h20v40H22z' fill='%23bd9a60'/%3E%3Cpath d='m22 20 20-8v9l-20 8zm0 18 20-8v9l-20 8z' fill='%23f2ebdf'/%3E%3C/svg%3E"
    />
    <link rel="stylesheet" href="/templates/website/motion/barber-01/styles.css" />
    <script is:inline src="/templates/website/motion/barber-01/app.js" defer></script>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={seoCopy.imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={seoCopy.imageAlt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData(path, title, description)).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <aside class="demo-bar" aria-label="Website demonstration controls">
      <a class="agency" href="/">FinTaxTech<span class="agency-dot"></span></a>
      <a class="demo-label" href={motionGallery.route}>{motionGallery.backLabel}</a>
      <button class="edit-name" type="button" data-personalise
        >Try your business name <span aria-hidden="true">↗</span></button
      >
    </aside>
    <header class="site-header">
      <a class="brand" href="#home" aria-label="Back to the top">
        <span class="brand-mark" data-monogram aria-hidden="true">B / S</span>
        <span data-business>The Brass Standard</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation"
        >Menu <span aria-hidden="true">+</span></button
      >
      <nav id="navigation" aria-label="Main navigation">
        <a href="#services">The services</a><a href="#ritual">The ritual</a><a href="#visit"
          >Find your moment</a
        >
        <button type="button" class="button button-small" data-book
          >Take a seat <span aria-hidden="true">↗</span></button
        >
      </nav>
    </header>
    <main id="main">
      <section class="hero section-pad" id="home" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="small-line"></span> THE MODERN BARBER. THE TIMELESS RITUAL.
          </p>
          <p class="hero-business">
            <span data-business>{c.defaultName}</span><span data-hero-area hidden></span>
          </p>
          <h1 id="hero-title">A cut<br />above the<br /><em>ordinary.</em></h1>
          <p class="hero-description">
            Sharp cuts. Considered details. A little time that’s entirely yours.
          </p>
          <a class="button" href="#services"
            >Find your signature <span aria-hidden="true">↗</span></a
          >
          <div class="hero-footnote">
            <span class="status-dot"></span> A fresh perspective on a classic craft
          </div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <span class="art-coordinate coord-top">THE ART OF LOOKING SHARP</span>
          <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
          <div class="pole-shadow"></div>
          <div class="barber-pole">
            <div class="pole-finial"></div><div class="pole-cap top-cap"></div>
            <div class="pole-glass">
              <div class="pole-stripes"></div><div class="pole-reflection"></div>
            </div>
            <div class="pole-cap bottom-cap"></div><div class="pole-foot"></div>
          </div>
          <span class="art-note note-left">TRADITION<br /><span>REIMAGINED.</span></span>
          <span class="art-note note-right">01 /<br /><span>THE STANDARD</span></span>
          <div class="round-stamp">CRAFT OVER COMPROMISE <span>✳</span></div>
          <span class="art-coordinate coord-bottom">PRECISION IN EVERY DETAIL — EST. YOUR WAY</span>
        </div>
        <a class="scroll-cue" href="#services"
          ><span aria-hidden="true">↓</span> SCROLL TO DISCOVER</a
        >
      </section>
      <div class="ticker" aria-hidden="true">
        <div>
          PRECISION CUTS <i>✳</i> CLEAN FADES <i>✳</i> HOT TOWEL RITUALS <i>✳</i> GOOD CONVERSATION <i
            >✳</i
          > PRECISION CUTS <i>✳</i> CLEAN FADES <i>✳</i> HOT TOWEL RITUALS <i>✳</i> GOOD CONVERSATION
          <i>✳</i>
        </div>
      </div>
      <section class="services section-pad" id="services" aria-labelledby="services-title">
        <div class="section-heading reveal">
          <p class="eyebrow">01 / THE SERVICES</p><h2 id="services-title">
            Your style.<br /><em>Our attention.</em>
          </h2><p>A clean fade or a complete change.<br />It starts with a conversation.</p>
        </div>
        <div class="service-list">
          {
            c.services.map((service, index) => (
              <button class="service-row reveal" data-service={service.name}>
                <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="service-detail">
                  <strong>{service.name}</strong>
                  <span>{`${service.description} · ${service.duration}`}</span>
                </span>
                <span class="service-price">
                  {service.price} <span aria-hidden="true">↗</span>
                </span>
              </button>
            ))
          }
          <p class="sample-note">Illustrative services, durations and prices for this demo.</p>
        </div>
      </section>
      <section class="ritual" id="ritual" aria-labelledby="ritual-title">
        <div class="ritual-sticky section-pad">
          <div class="ritual-header">
            <p class="eyebrow">02 / THE RITUAL</p><p class="ritual-instruction">
              SCROLL. WATCH THE CRAFT UNFOLD. <span aria-hidden="true">↓</span>
            </p>
          </div>
          <h2 id="ritual-title">The difference<br />is in <em>the details.</em></h2>
          <div class="razor-stage" aria-hidden="true">
            <span class="razor-guide"></span>
            <svg class="razor" viewBox="0 0 1000 340" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="steel" x1="0" y1="0" x2="0" y2="1"
                  ><stop stop-color="#f8f5e9"></stop><stop offset=".28" stop-color="#a9aaa0"
                  ></stop><stop offset=".55" stop-color="#f0eee5"></stop><stop
                    offset=".8"
                    stop-color="#777e75"></stop><stop offset="1" stop-color="#e9e5d7"
                  ></stop></linearGradient
                >
                <linearGradient id="brass" x1="0" y1="0" x2=".4" y2="1"
                  ><stop stop-color="#e3c58c"></stop><stop offset=".45" stop-color="#b28c53"
                  ></stop><stop offset="1" stop-color="#665036"></stop></linearGradient
                >
                <linearGradient id="handle" x1="0" y1="0" x2="0" y2="1"
                  ><stop stop-color="#42493b"></stop><stop offset=".45" stop-color="#242b23"
                  ></stop><stop offset="1" stop-color="#111810"></stop></linearGradient
                >
                <filter id="shadow" x="-30%" y="-100%" width="160%" height="300%"
                  ><feDropShadow dx="0" dy="18" stdDeviation="12" flood-opacity=".28"
                  ></feDropShadow></filter
                >
              </defs>
              <g filter="url(#shadow)">
                <g class="razor-blade">
                  <path
                    d="M485 188 450 181 402 155 93 155Q76 155 71 133L56 65Q53 51 72 51H400Q423 51 429 74L442 128 485 152Z"
                    fill="url(#steel)"
                    stroke="#a8aa9e"></path>
                  <path d="M76 62H397Q413 62 417 78L432 138H88Z" fill="#555c54" opacity=".42"
                  ></path>
                  <path d="M94 148H399L428 163H100Z" fill="#fffdf0"></path>
                  <path d="M110 79H365" stroke="#f5f1e3" stroke-opacity=".6"></path>
                  <text
                    x="238"
                    y="112"
                    text-anchor="middle"
                    fill="#e9e5d9"
                    font-family="Georgia, serif"
                    font-size="16"
                    letter-spacing="5">THE STANDARD</text
                  >
                </g>
                <path
                  d="M479 148Q501 139 529 143L887 163Q928 166 930 191Q925 219 884 215L526 197Q501 198 479 183Z"
                  fill="url(#brass)"></path>
                <path
                  d="M518 152 887 174Q913 175 915 190Q912 205 884 205L522 187Z"
                  fill="url(#handle)"
                  stroke="#99835a"></path>
                <path d="M548 160 874 180" stroke="#65705a" opacity=".5"></path>
                <circle cx="484" cy="166" r="20" fill="url(#brass)" stroke="#e4c98f"
                ></circle><circle cx="484" cy="166" r="8" fill="#292d24"></circle><path
                  d="m480 170 8-8"
                  stroke="#c8b583"
                  stroke-width="2"></path>
                <circle cx="885" cy="189" r="5" fill="url(#brass)"></circle>
              </g>
            </svg>
            <span class="tool-label label-one">STAINLESS PRECISION</span><span
              class="tool-label label-two">THE FINISHING TOUCH</span
            >
          </div>
          <div class="ritual-bottom">
            <div>
              <p class="eyebrow" id="ritual-step">{c.ritual[0][0]}</p><p id="ritual-copy">
                {c.ritual[0][1]}
              </p>
            </div><div class="ritual-progress" aria-hidden="true"><span></span></div><span
              class="ritual-count"
              aria-hidden="true">01 — 03</span
            >
          </div>
          <ol class="ritual-steps">
            {
              c.ritual.map(([title, description]) => (
                <li>
                  <>
                    <strong>{title}</strong>
                    <p>{description}</p>
                  </>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
      <section class="story section-pad" aria-labelledby="story-title">
        <div class="story-emblem reveal" aria-hidden="true">
          <span class="emblem-top">MADE FOR YOUR EVERYDAY</span><span class="emblem-scissors"
            >✂</span
          ><span class="emblem-bottom">A LITTLE EXTRAORDINARY</span>
        </div>
        <div class="story-copy reveal">
          <p class="eyebrow">03 / YOUR NEW REGULAR</p><h2 id="story-title">
            Look sharp.<br /><em>Feel yourself.</em>
          </h2><p>
            At <span data-business>The Brass Standard</span>, the chair is yours. Bring an idea, a
            reference, or just yourself. We’ll take it from there.
          </p><p class="story-small">
            A thoughtful cut. An unhurried moment. A reason to come back.
          </p><a class="text-link" href="#visit"
            >Make time for yourself <span aria-hidden="true">↗</span></a
          >
        </div>
      </section>
      <section class="cuts-section section-pad" id="gallery" aria-labelledby="gallery-title">
        <p class="eyebrow">{c.galleryEyebrow}</p><h2 id="gallery-title">{c.galleryTitle}</h2>
        <p class="section-note">{c.galleryNote}</p>
        <!-- Original SVG placeholder illustrations made for this demo; no stock images or third-party licensing dependencies. -->
        <div class="cuts-grid">
          {
            c.cuts.map((cut, index) => (
              <figure>
                <BarberCutIllustration index={index} label={`${c.illustrationLabel}: ${cut}`} />
                <figcaption>{cut}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>
      <section class="reviews-section section-pad" aria-labelledby="reviews-title">
        <h2 id="reviews-title">{c.reviewTitle}</h2>
        <p class="section-note">{c.reviewNote}</p>
        <div class="reviews-grid">
          {
            Array.from({ length: 3 }, () => (
              <div class="review-placeholder">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                  <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9Z" />
                </svg>
                <p>{c.reviewPlaceholder}</p>
              </div>
            ))
          }
        </div>
      </section>
      <section class="visit section-pad" id="visit" aria-labelledby="visit-title">
        <div class="visit-copy reveal">
          <p class="eyebrow">04 / YOUR NEXT GOOD HAIR DAY</p><h2 id="visit-title">
            Your chair<br /><em>is waiting.</em>
          </h2><button type="button" class="button" data-book
            >Explore booking <span aria-hidden="true">↗</span></button
          ><p class="sample-note">Demo only. No real appointments are created.</p><p
            class="booking-integration"
          >
            {c.integration}
          </p>
        </div><div class="visit-info reveal">
          <div>
            <p class="eyebrow">THE HOURS</p><p>
              {
                c.hours.map(([days, hours], index) => (
                  <>
                    {index > 0 && <br />}
                    {days} <span>{hours}</span>
                  </>
                ))
              }
            </p>
          </div><div>
            <p class="eyebrow">THE LOCATION</p><p data-area>{c.addressPlaceholder}</p><p
              class="sample-note"
            >
              {c.locationNote}
            </p>
          </div>
        </div>
      </section>
      <section
        class="contact-section section-pad"
        id="contact-details"
        aria-labelledby="contact-title"
      >
        <div>
          <h2 id="contact-title">{c.contactLabel}</h2>
          <p class="section-note" data-phone-text>{c.phonePlaceholder}</p>
          <div class="contact-actions">
            <a class="button" href="#contact-details" data-call>{c.call}</a>
            <a class="button" href="#contact-details" data-whatsapp>{c.whatsapp}</a>
            <a class="text-link" href="#map-preview" data-directions>{c.directions}</a>
          </div>
        </div>
        <div class="map-preview" id="map-preview">
          <span aria-hidden="true" class="map-pin">⌖</span>
          <p data-area>{c.addressPlaceholder}</p><p class="section-note">{c.mapNote}</p>
        </div>
      </section>
    </main>
    <footer class="site-footer section-pad">
      <a class="brand footer-brand" href="#home"
        ><span class="brand-mark" data-monogram aria-hidden="true">B / S</span><span data-business
          >The Brass Standard</span
        ></a
      ><p>A demonstration website by <a href="/">FinTaxTech ↗</a></p><span
        ><a href={motionGallery.route}>{motionGallery.backLabel}</a></span
      >
      {visitConfig.endpoint && visitConfig.codes && <p class="visit-notice">{c.visitNotice}</p>}
    </footer>
    <aside class="enquiry-strip">
      <div>
        <span class="status-dot"></span><p>
          Picture your business here?<span>We’ll make it yours.</span>
        </p>
      </div><a class="text-link" href={c.briefRoute} data-brief-link
        >Enquire about this template <span aria-hidden="true">↗</span></a
      >
    </aside>
    <aside class="mobile-actions" aria-label={c.mobileLabel}>
      <a href="#contact-details" data-call>{c.call}</a><button type="button" data-book
        >{c.book}</button
      >
    </aside>
    <dialog id="name-dialog" aria-labelledby="name-title" aria-describedby="name-description">
      <button class="dialog-close" type="button" data-close aria-label={c.closeLabel}>×</button><p
        class="eyebrow"
      >
        FINTAXTECH / BARBER NO. 01
      </p><span class="dialog-symbol" aria-hidden="true">✳</span><h2 id="name-title">
        Your name.<br /><em>Your next website.</em>
      </h2><p id="name-description">
        See this barber website with your business name. A small preview of what we could build for
        you.
      </p><form id="name-form" autocomplete="off">
        <label for="business-name">Business name</label><input
          id="business-name"
          name="business-name"
          type="text"
          placeholder="Turkish Barber London Bridge"
          maxlength="100"
          autocomplete="off"
          required
        /><p class="input-hint">{c.nameHint}</p><button class="button" type="submit"
          >Preview my website <span aria-hidden="true">↗</span></button
        >
      </form><button type="button" class="browse-default" id="browse-default"
        >Explore the sample first</button
      >
    </dialog>
    <dialog
      id="booking-dialog"
      aria-labelledby="booking-title"
      aria-describedby="booking-description"
    >
      <button class="dialog-close" type="button" data-close aria-label={c.closeLabel}>×</button><p
        class="eyebrow"
      >
        EXAMPLE BOOKING EXPERIENCE
      </p><h2 id="booking-title">
        Take a<br /><em>moment.</em>
      </h2><p id="booking-description">
        Imagine booking with <span data-business>The Brass Standard</span>. Try selecting a service
        below.
      </p><form id="booking-form">
        <label for="booking-service">Your service</label><select id="booking-service"
          >{c.services.map((service) => <option>{service.name}</option>)}</select
        ><button class="button" type="submit"
          >See the next step <span aria-hidden="true">↗</span></button
        >
      </form><form id="booking-slots" hidden>
        <h3 tabindex="-1">{c.slotsTitle}</h3>
        <p class="slot-note">{c.slotNote}</p>
        <label for="booking-day">{c.day}</label><select id="booking-day"
          >{c.sampleDays.map((day) => <option>{day}</option>)}</select
        >
        <label for="booking-time">{c.time}</label><select id="booking-time"
          >{c.sampleTimes.map((time) => <option>{time}</option>)}</select
        >
        <button class="button" type="submit">{c.continueBooking}</button>
        <button class="browse-default" type="button" data-booking-back>{c.back}</button>
      </form>
      <div id="booking-confirmation" hidden>
        <h3 tabindex="-1">{c.confirmationTitle}</h3>
        <p id="booking-summary"></p><p class="booking-result" id="booking-result">
          {c.confirmation}
        </p>
        <a class="button booking-offer" href={c.briefRoute} data-brief-link
          >{c.bookingOfferBefore}<span data-business>{c.defaultName}</span>{c.bookingOfferAfter}</a
        >
        <a class="text-link booking-contact" href={c.contactRoute}>{c.contactAlternative}</a>
        <button class="browse-default" type="button" data-booking-restart>{c.restart}</button>
      </div><p class="input-hint">
        Demonstration only. This does not create an appointment or send information to a barbershop.
      </p>
    </dialog>
    <script
      id="barber-copy"
      type="application/json"
      is:inline
      set:html={JSON.stringify(c).replace(/</g, '\\u003c')}
    />
    <script
      id="barber-visit-config"
      type="application/json"
      is:inline
      set:html={JSON.stringify(visitConfig).replace(/</g, '\\u003c')}
    />
    <script>
      import '../../../../../scripts/barber-visits';
    </script>
    <div id="announcement" class="sr-only" aria-live="polite"></div>
    <noscript
      ><p class="noscript-note">
        This is a sample website. Enable JavaScript to preview your business name and try the
        booking demonstration.
      </p></noscript
    >
  </body>
</html>
