---
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-600.css';
import { templateTheme } from '../../../../../lib/template-theme';
import {
  THEME,
  beautyDemo as b,
  treatmentGroups,
  treatments,
} from '../../../../../content/beauty-demo';
import { motionTemplates, motionGallery } from '../../../../../content/templates';
import { seoPages } from '../../../../../content/seo';
import { absoluteURL, structuredData } from '../../../../../lib/seo';
import BeautyArtwork from '../../../../../components/templates/BeautyArtwork.astro';
const template = motionTemplates.find((item) => item.id === b.id)!;
const { title, description } = seoPages[b.route];
const canonical = absoluteURL(b.route);
const image = absoluteURL(template.preview.src);
const theme = templateTheme('beauty-08', THEME);
const groups = treatmentGroups.map((group) => ({
  ...group,
  items: treatments.filter((item) => item.group === group.id),
}));
const assets = '/templates/website/motion/beauty-08/';
---

<!doctype html>
<html lang="en" style={theme.style} data-custom-theme={theme.custom || undefined}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content={theme.pageBackground} />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/mark.svg" />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} /><meta
      property="og:image:alt"
      content={template.preview.alt}
    />
    <meta property="og:image:width" content={String(template.preview.width)} /><meta
      property="og:image:height"
      content={String(template.preview.height)}
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    />
    <meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={image}
    /><meta name="twitter:image:alt" content={template.preview.alt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        structuredData(b.route, title, description, undefined, image),
      ).replace(/</g, '\\u003c')}
    />
    <link rel="stylesheet" href={`${assets}styles.css`} />
    <!-- The blocking script observes streamed identity nodes before their first paint.
         Values are assigned only as text, or as tel:/wa.me links built from digits.
         No query data enters requests or storage. -->
    <script is:inline src="/templates/website/motion/beauty-08/identity.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <aside class="demo-strip" aria-label="Demonstration controls">
      <a href="/" class="agency">FinTaxTech <span aria-hidden="true">↗</span></a>
      <span class="demo-id">{b.label}</span>
      <a class="gallery-link" href={motionGallery.route}>All templates</a>
      <a class="agency-contact" href="/contact/" data-agency-link>Discuss this website</a>
      <button type="button" data-edit>Change name</button>
    </aside>
    <header class="business-header wrap">
      <a class="brand" href="#home" aria-label="Back to the top"
        ><span class="monogram" data-monogram aria-hidden="true">{b.monogram}</span><span
          data-business>{b.name}</span
        ></a
      >
      <nav aria-label="Main navigation">
        <a href="#treatments">Treatments</a><a href="#lashes-brows">Lashes &amp; brows</a><a
          href="#gallery">Gallery</a
        ><a href="#contact">Visit us</a>
      </nav>
      <a class="header-action" href="#treatments" data-book>Book now</a>
    </header>
    <main id="main">
      <section class="hero wrap" id="home" data-capture="hero">
        <div class="hero-copy">
          <p class="eyebrow">{b.hero.eyebrow} · <span data-hero-area>{b.area}</span></p>
          <h1>
            <span class="name-wrap"
              ><span data-business>{b.name}</span><span class="name-stroke" aria-hidden="true"
              ></span><span class="name-brush" aria-hidden="true"></span></span
            >
          </h1>
          <p class="tagline">{b.hero.tagline}</p>
          <p class="lead">{b.hero.description}</p>
          <div class="hero-actions">
            <a class="button accent" href="#treatments" data-book data-capture="demo"
              >{b.hero.action} <span aria-hidden="true">→</span></a
            >
            <a class="text-link" href="#treatments">See treatments &amp; prices</a>
          </div>
          <p class="small-note">{b.hero.note}</p>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="hero-halo"></div>
          <BeautyArtwork kind="bottle" />
          <div class="hero-card">
            <span class="eyebrow"><span class="live-dot"></span>LATE EVENINGS · EXAMPLE</span>
            <strong>Open till 8:30pm</strong>
            <span>Thursday &amp; Friday</span>
          </div>
        </div>
      </section>
      <section
        class="section wrap treatments"
        id="treatments"
        data-capture="services"
        aria-labelledby="treatments-title"
      >
        <header class="section-heading" data-reveal>
          <p class="eyebrow">01 · TREATMENTS</p>
          <h2 id="treatments-title">Treatments &amp; <em>prices.</em></h2>
          <p>Example treatments, times and prices, ready to be replaced with your own menu.</p>
        </header>
        <div class="tabs" role="tablist" aria-label="Treatment types">
          {
            groups.map((group, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${group.id}`}
                aria-controls={`panel-${group.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab={group.id}
              >
                {group.label}
              </button>
            ))
          }
        </div>
        <div class="price-panels" data-prices>
          {
            groups.map((group, i) => (
              <div
                class:list={['price-panel', { 'is-active': i === 0 }]}
                role="tabpanel"
                id={`panel-${group.id}`}
                aria-labelledby={`tab-${group.id}`}
                data-panel={group.id}
              >
                <>
                  <h3 class="panel-title">{group.label}</h3>
                  <ul class="price-list">
                    {group.items.map((item, k) => (
                      <li class="price-row" style={`--i:${k}`}>
                        <>
                          <div class="row-copy">
                            <>
                              <h4>{item.name}</h4>
                              <p>{item.description}</p>
                            </>
                          </div>
                          <span class="duration">{item.duration}</span>
                          <span class="price-tag">
                            <>
                              <strong data-sample-price>{item.price}</strong>
                              <span class="shimmer" aria-hidden="true" />
                            </>
                          </span>
                          <a class="row-book" href="#contact" data-service={item.id}>
                            <>
                              Book<span class="sr-only"> {item.name}</span>
                            </>
                          </a>
                        </>
                      </li>
                    ))}
                  </ul>
                </>
              </div>
            ))
          }
        </div>
        <p class="small-note price-note">
          Example prices · Your own price list, deposits and booking times go here.
        </p>
      </section>
      <section class="story section" id="appointment" aria-labelledby="story-title">
        <div class="wrap">
          <header class="section-heading" data-reveal>
            <p class="eyebrow">02 · YOUR VISIT</p>
            <h2 id="story-title">Your appointment, <em>start to finish.</em></h2>
            <p>Scroll to watch a manicure come together, one coat at a time.</p>
          </header>
          <div class="story-layout">
            <figure class="story-stage" data-capture="motion">
              <div class="hand-scene" data-story>
                <BeautyArtwork kind="hand" />
              </div>
              <p class="stage-caption" aria-hidden="true">
                <span data-stage-number>04</span>
                <span data-stage-caption>{b.story[3][0]}</span>
              </p>
              <div class="motion-progress" aria-hidden="true"><span></span></div>
              <figcaption class="small-note">
                An original illustration, not a real client.
              </figcaption>
            </figure>
            <ol class="story-steps">
              {
                b.story.map(([heading, text], i) => (
                  <li>
                    <>
                      <span class="step-number">0{i + 1}</span>
                      <div>
                        <>
                          <h3>{heading}</h3>
                          <p>{text}</p>
                        </>
                      </div>
                    </>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>
      <section class="section wrap" id="lashes-brows" aria-labelledby="lashes-title">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">03 · LASHES &amp; BROWS</p>
          <h2 id="lashes-title">The finishing <em>frame.</em></h2>
          <p>Illustrated examples. No real before and after photos are shown.</p>
        </header>
        <div class="feature-grid">
          <article class="feature-card">
            <div class="feature-art" data-lashes>
              <BeautyArtwork kind="eye" />
              <span class="art-tag">Illustrated example</span>
            </div>
            <div class="feature-copy">
              <h3>{b.lashes.title}</h3>
              <p>{b.lashes.text}</p>
              <a class="text-link" href="#treatments" data-tab-link="lashes">See lash treatments</a>
            </div>
          </article>
          <article class="feature-card">
            <div class="feature-art" data-brows>
              <BeautyArtwork kind="brow" />
              <span class="art-tag">Illustrated example</span>
            </div>
            <div class="feature-copy">
              <h3>{b.brows.title}</h3>
              <p>{b.brows.text}</p>
              <a class="text-link" href="#treatments" data-tab-link="brows">See brow treatments</a>
            </div>
          </article>
        </div>
        <p class="patch-note" role="note" data-reveal>
          <span class="patch-icon" aria-hidden="true">!</span><span
            ><strong>Patch test.</strong>{' '}
            {b.patchTest}</span
          >
        </p>
      </section>
      <section
        class="gallery section"
        id="gallery"
        data-capture="gallery"
        aria-labelledby="gallery-title"
      >
        <div class="wrap">
          <header class="section-heading" data-reveal>
            <p class="eyebrow">04 · GALLERY</p>
            <h2 id="gallery-title">Fresh from <em>the studio.</em></h2>
            <p>Your own photos and Instagram posts go here.</p>
          </header>
          <div class="insta-head" data-reveal>
            <span class="monogram" data-monogram aria-hidden="true">{b.monogram}</span>
            <div>
              <strong data-business>{b.name}</strong>
              <span>@yoursalon · Instagram placeholder</span>
            </div>
          </div>
          <div class="insta-grid" data-gallery>
            {
              b.gallery.map((tile, i) => (
                <figure class="tile" style={`--i:${i}`}>
                  <>
                    <BeautyArtwork kind={tile.kind} tile />
                    <figcaption>
                      <>
                        <span class="tile-tag">Example</span>
                        <span>{tile.label}</span>
                      </>
                    </figcaption>
                  </>
                </figure>
              ))
            }
          </div>
        </div>
      </section>
      <section class="section wrap care" id="before" aria-labelledby="care-title">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">05 · GOOD TO KNOW</p>
          <h2 id="care-title">Before your appointment <em>&amp; after.</em></h2>
          <p>Example advice. Your own guidance and aftercare go here.</p>
        </header>
        <div class="care-grid">
          <div class="care-card" data-reveal>
            <h3>Before your appointment</h3>
            <ul>{b.before.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="care-card" data-reveal>
            <h3>Aftercare</h3>
            <ul>{b.aftercare.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
      </section>
      <section class="reviews section" data-capture="reviews" aria-labelledby="reviews-title">
        <div class="wrap">
          <header class="section-heading" data-reveal>
            <p class="eyebrow">06 · KIND WORDS</p>
            <h2 id="reviews-title">Clients <em>love it here.</em></h2>
            <p>Example reviews — your real Google reviews appear here.</p>
          </header>
          <div class="review-grid">
            {
              b.reviews.map((r) => (
                <article class="review-card" data-sample-review data-reveal>
                  <>
                    <div class="review-top">
                      <>
                        <span class="avatar" aria-hidden="true">
                          {r.initials}
                        </span>
                        <div>
                          <>
                            <h3>{r.name}</h3>
                            <p class="review-date">{r.date}</p>
                          </>
                        </div>
                        <span class="review-tag">Example review</span>
                      </>
                    </div>
                    <p class="stars" role="img" aria-label="5 out of 5 stars (example)">
                      ★★★★★
                    </p>
                    <p>{r.text}</p>
                  </>
                </article>
              ))
            }
          </div>
        </div>
      </section>
      <section class="section wrap policies" aria-labelledby="policies-title">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">07 · POLICIES &amp; GIFTS</p>
          <h2 id="policies-title">The small <em>print, made kind.</em></h2>
        </header>
        <div class="policy-grid">
          <div class="policy-card" data-reveal>
            <p class="eyebrow">CANCELLATIONS &amp; DEPOSITS · PLACEHOLDER</p>
            <h3>Your booking policy here</h3>
            <p>
              Example: a small deposit secures your appointment and comes off your bill. Please give
              24 hours’ notice to move or cancel. Your own policy goes here.
            </p>
          </div>
          <div class="voucher-card" data-reveal>
            <div class="voucher">
              <span class="monogram" data-monogram aria-hidden="true">{b.monogram}</span>
              <p class="eyebrow">GIFT VOUCHER · EXAMPLE</p>
              <strong data-business>{b.name}</strong>
              <span class="voucher-value" data-sample-price>£25</span>
            </div>
            <p>Gift vouchers from £20, for any treatment. Example values.</p>
            <button class="button" type="button" data-voucher
              >Ask about gift vouchers <span aria-hidden="true">→</span></button
            >
          </div>
        </div>
      </section>
      <section
        class="contact section"
        id="contact"
        data-capture="contact"
        aria-labelledby="contact-title"
      >
        <div class="wrap">
          <header class="section-heading" data-reveal>
            <p class="eyebrow">08 · VISIT US</p>
            <h2 id="contact-title">Come and <em>see us.</em></h2>
            <p class="contact-line">
              <span data-business>{b.name}</span>{' · '}<span data-area>{b.area}</span>
            </p>
          </header>
          <div class="details-grid">
            <div class="contact-card">
              <p class="eyebrow">BOOK ONLINE · DEMO</p>
              <h3>Pick a treatment and a time.</h3>
              <p>Try the booking journey. Nothing is booked, charged or sent.</p>
              <button class="button accent" type="button" data-book
                >Book an appointment <span aria-hidden="true">→</span></button
              >
              <div class="contact-actions">
                <a href="#contact" data-call>Call <span data-phone>Your number here</span></a><a
                  href="#contact"
                  data-whatsapp>WhatsApp <span data-phone>Your number here</span></a
                ><button type="button" data-directions>Directions</button>
              </div>
              <p class="small-note">
                Already use Fresha, Booksy or Treatwell? We’ll connect your booking link.
              </p>
            </div>
            <div class="hours">
              <h3>Opening hours</h3>
              <p class="small-note">Example hours · late evenings Thursday &amp; Friday</p>
              <dl>
                {
                  b.hours.map(([day, hours]) => (
                    <div>
                      <>
                        <dt>{day}</dt>
                        <dd>{hours}</dd>
                      </>
                    </div>
                  ))
                }
              </dl>
            </div>
            <div class="map-card">
              <svg class="map-drawing" viewBox="0 0 360 200" aria-hidden="true" focusable="false">
                <rect width="360" height="200" class="f-brand-soft"></rect>
                <path d="M-10 140C90 110 170 170 370 90" class="s-paper" stroke-width="16"></path>
                <path d="M110-10 140 210M250-10l-30 220" class="s-paper" stroke-width="10"></path>
                <rect x="24" y="22" width="70" height="46" rx="8" class="f-accent-soft"></rect>
                <rect x="268" y="132" width="70" height="48" rx="8" class="f-accent-soft"></rect>
                <path
                  d="M190 50c-17 0-30 13-30 30 0 23 30 50 30 50s30-27 30-50c0-17-13-30-30-30Z"
                  class="f-brand"></path>
                <circle cx="190" cy="80" r="11" class="f-accent"></circle>
              </svg>
              <div class="map-copy">
                <p class="eyebrow">FIND THE STUDIO</p>
                <h3 data-area>{b.area}</h3>
                <p class="small-note">Your address here · parking details · map placeholder</p>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="agency-offer" aria-labelledby="offer-title">
        <div class="wrap offer-inner" data-reveal>
          <div>
            <p class="eyebrow">TOP COAT / BEAUTY-08 · BY FINTAXTECH</p>
            <h2 id="offer-title">Picture your business here? <em>We’ll make it yours.</em></h2>
            <p>
              A website for <span data-business>{b.name}</span>, with your treatments and booking.
            </p>
          </div>
          <a class="button accent" href="/contact/" data-agency-link
            >Talk to FinTaxTech <span aria-hidden="true">→</span></a
          >
        </div>
      </section>
      <noscript
        ><p class="wrap">
          This is a demonstration website. Enable JavaScript to personalise the name or try the
          booking. <a href="/contact/">Contact FinTaxTech about your website.</a>
        </p></noscript
      >
    </main>
    <footer class="wrap site-footer">
      <a class="brand" href="#home"
        ><span class="monogram" data-monogram aria-hidden="true">{b.monogram}</span><span
          data-business>{b.name}</span
        ></a
      >
      <p>
        A fictional salon, shown as a demonstration by FinTaxTech.<br />No bookings, deposits,
        messages or payments are submitted.
      </p>
      <a href={motionGallery.route}>{motionGallery.backLabel} <span aria-hidden="true">↗</span></a>
    </footer>
    <div class="mobile-contact" aria-label="Example contact actions">
      <a href="#contact" data-call>Call</a><a href="#treatments" data-book>Book now</a>
    </div>
    <dialog id="name-dialog" aria-labelledby="name-title" aria-describedby="name-description">
      <button class="close" data-close type="button" aria-label="Close name dialog">×</button>
      <p class="eyebrow">YOUR NAME, YOUR WEBSITE</p>
      <h2 id="name-title">{b.nameDialog.title}</h2>
      <p id="name-description">{b.nameDialog.description}</p>
      <form id="name-form" novalidate>
        <label for="business-name">Your business name</label><input
          id="business-name"
          name="business"
          maxlength="100"
          placeholder="The Lash Loft"
          autocomplete="off"
          aria-describedby="name-hint name-error"
        />
        <p id="name-error" class="form-error" role="alert"></p>
        <p id="name-hint" class="small-note">
          Up to 100 characters. Kept only in this page and its URL.
        </p>
        <button class="button accent" type="submit"
          >Preview my website <span aria-hidden="true">→</span></button
        >
      </form>
      <div class="dialog-links">
        <button id="restore-name" class="text-button" type="button"
          >Explore the sample / restore default</button
        ><button id="copy-link" class="text-button" type="button">Copy your link</button>
      </div>
    </dialog>
    <dialog id="book-dialog" aria-labelledby="book-title" aria-describedby="book-intro">
      <button class="close" data-close type="button" aria-label="Close booking demo">×</button>
      <p class="eyebrow">EXAMPLE BOOKING · NOTHING IS SENT</p>
      <h2 id="book-title">Book an appointment.</h2>
      <p id="book-intro">Try booking a treatment at <span data-business>{b.name}</span>.</p>
      <ol class="flow-progress" aria-label="Booking steps">
        <li data-step-indicator>1. Treatment</li><li data-step-indicator>2. Time</li><li
          data-step-indicator
        >
          3. Done
        </li>
      </ol>
      <form id="treatment-form">
        <h3 tabindex="-1">01 / Choose a treatment</h3>
        <label for="book-treatment">Treatment</label><select
          id="book-treatment"
          aria-describedby="book-price"
          >{
            groups.map((group) => (
              <optgroup label={group.label}>
                {group.items.map((item) => (
                  <option
                    value={item.id}
                    data-name={item.name}
                    data-duration={item.duration}
                    data-price={item.price}
                  >
                    {item.name}
                  </option>
                ))}
              </optgroup>
            ))
          }</select
        >
        <p id="book-price" class="book-price">
          <span data-book-duration>{treatments[0].duration}</span> · Example price:{' '}
          <strong data-sample-price>{treatments[0].price}</strong>
        </p>
        <button class="button accent" type="submit"
          >Next: technician &amp; time <span aria-hidden="true">→</span></button
        >
      </form>
      <form id="time-form" hidden>
        <h3 tabindex="-1">02 / Choose a technician and time</h3>
        <p>Sample technicians and times. No name, email or phone number needed.</p>
        <label for="book-tech">Technician</label><select id="book-tech"
          >{b.flow.technicians.map((name) => <option>{name}</option>)}</select
        ><label for="book-day">Day</label><select id="book-day"
          >{b.flow.days.map((day) => <option>{day}</option>)}</select
        ><label for="book-time">Time</label><select id="book-time"
          >{b.flow.times.map((time) => <option>{time}</option>)}</select
        >
        <button class="button accent" type="submit"
          >See my booking <span aria-hidden="true">→</span></button
        ><button class="text-button" type="button" data-restart>Back</button>
      </form>
      <div id="book-final" hidden>
        <h3 tabindex="-1">03 / See you soon.</h3>
        <div class="booked-card">
          <span class="sparkles" aria-hidden="true"
            >{Array.from({ length: 12 }, (_, i) => <i style={`--i:${i}`} />)}</span
          >
          <span class="monogram" data-monogram aria-hidden="true">{b.monogram}</span>
          <div>
            <p class="eyebrow">BOOKED · EXAMPLE</p>
            <strong class="booked-name" data-business>{b.name}</strong>
            <p id="book-summary" class="book-summary"></p>
          </div>
        </div>
        <p>
          This is where clients would book and pay a deposit on your finished website. <strong
            >Demo only — nothing is booked or charged.</strong
          >
        </p>
        <a class="button accent" href="/contact/" data-agency-link
          ><span>Want this for <span data-business>{b.name}</span>? Talk to FinTaxTech</span>
          <span aria-hidden="true">→</span></a
        ><button class="text-button" type="button" data-restart>Book something else</button>
      </div>
    </dialog>
    <dialog id="contact-dialog" aria-labelledby="contact-dialog-title">
      <button class="close" data-close type="button" aria-label="Close contact preview">×</button>
      <p class="eyebrow">EXAMPLE CONTACT ACTION</p>
      <h2 id="contact-dialog-title">Contact preview</h2>
      <p data-business>{b.name}</p>
      <p id="contact-explanation"></p>
      <p class="contact-preview-value"></p>
