---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { galleryTemplates, websiteCategories, websiteGallery } from '../../../content/templates';

const cards = websiteCategories.map((category) => {
  const featured = galleryTemplates.find((template) => template.id === category.featuredId);
  if (!featured) throw new Error(`Missing category preview: ${category.featuredId}`);
  return { ...category, preview: featured.preview };
});
---

<SiteLayout title={websiteGallery.title} description={websiteGallery.description}>
  <div class="container directory">
    <h1>{websiteGallery.title}</h1>
    <ul class="categories" role="list">
      {
        cards.map(({ route, title, description, linkLabel, featuredId, preview }) => (
          <li>
            <a class="category" href={route} aria-labelledby={`title-${featuredId}`}>
              <img {...preview} decoding="async" />
              <div class="details">
                <h2 id={`title-${featuredId}`}>{title}</h2>
                <p>{description}</p>
                <span class="explore">
                  {linkLabel} <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</SiteLayout>

<style>
  .directory {
    padding-block: var(--space-6) var(--space-9);
  }
  .categories {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    margin: var(--space-6) 0 0;
    list-style: none;
  }
  li {
    min-width: 0;
    margin: 0;
  }
  .category {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--space-3);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .category:is(:hover, :focus-visible) {
    border-color: var(--accent);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .details {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-2) var(--space-2);
  }
  h2 {
    margin: 0 0 var(--space-2);
    font-size: clamp(var(--h3), 5vw, var(--h2));
  }
  .explore {
    margin-top: auto;
    color: var(--accent);
    font-weight: var(--weight-strong);
  }
  .category:is(:hover, :focus-visible) .explore {
    text-decoration: underline;
  }
  @media (--tablet) {
    .categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
