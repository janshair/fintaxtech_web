---
import GoogleTag from '../../../../../components/GoogleTag.astro';
import Icons from './_parts/Icons.astro';
import FlatCup from './_parts/FlatCup.astro';
import DemoStrip from '../../../../../components/templates/three/DemoStrip.astro';
import NameDialog from '../../../../../components/templates/three/NameDialog.astro';
import { templateTheme } from '../../../../../lib/template-theme';
import { THEME, fruits, juiceBarDemo as c } from '../../../../../content/juice-bar-demo';
import { threeDTemplates, threeDGallery } from '../../../../../content/templates';
import { seoPages } from '../../../../../content/seo';
import { absoluteURL, structuredData } from '../../../../../lib/seo';
const template = threeDTemplates.find((item) => item.id === c.id)!;
const { title, description } = seoPages[c.route];
const canonical = absoluteURL(c.route);
const image = absoluteURL(template.preview.src);
const assets = c.route;
const theme = templateTheme('juice-bar-05', THEME);
---

<!doctype html>
<html lang="en" style={theme.style} data-custom-theme={theme.custom || undefined}>
  <head>
    <!-- Charset and referrer policy come first, so no request (analytics
         included) can carry the personalised preview URL as its referrer. -->
    <meta charset="utf-8" /><meta name="referrer" content="no-referrer" />
    <GoogleTag />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={theme.pageBackground} />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/mark.svg" />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} /><meta
      property="og:image:alt"
      content={template.preview.alt}
    />
    <meta property="og:image:width" content={String(template.preview.width)} /><meta
      property="og:image:height"
      content={String(template.preview.height)}
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    />
    <meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={image}
    /><meta name="twitter:image:alt" content={template.preview.alt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        structuredData(c.route, title, description, undefined, image),
      ).replace(/</g, '\\u003c')}
    />
    <link
      rel="preload"
      href={assets + 'fonts/bagel-fat-one-400.woff2'}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={assets + 'fonts/figtree-500.woff2'}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={assets + 'styles.css'} />
    <!-- The blocking script observes streamed identity nodes before their first paint.
         Values are assigned only as text. No query data enters requests or storage. -->
    <script
      is:inline
      src="/templates/website/3d/_shared/identity.js"
      data-sample-name={c.name}
      data-sample-area={c.area}
      data-sample-initials={c.monogram}
      data-template-id={c.id}
      data-title-suffix="Juice bar website demo by FinTaxTech"
      data-sample-phone={c.phone.display}
      data-sample-tel={c.phone.tel}
      data-sample-intl={c.phone.international}
      data-loader-key="tumble-cup-loader"></script>
  </head>
  <body>
    <Icons />
    <div class="loader" data-loader>
      <svg class="loader-cup" viewBox="0 0 220 300" aria-hidden="true">
        <defs><clipPath id="loader-clip"><path d="M40 70h140l-16 196H56z"></path></clipPath></defs>
        <g class="loader-fruit">
          <use href="#i-strawberry" x="66" y="-60" width="46" height="46"></use>
          <use href="#i-mango" x="112" y="-60" width="46" height="46"></use>
          <use href="#i-pineapple" x="88" y="-60" width="46" height="46"></use>
        </g>
        <g clip-path="url(#loader-clip)"
          ><rect class="loader-fill" x="30" y="70" width="160" height="210"></rect><path
            class="loader-surface"
            d="M20 0c20-8 40-8 60 0s40 8 60 0 40-8 60 0v20H20z"></path></g
        >
        <path class="loader-glass" d="M40 70h140l-16 196H56z"></path>
        <path class="loader-rim" d="M32 62h156v10H32z"></path>
      </svg>
      <p class="loader-word" aria-hidden="true" data-business>{c.name}</p>
      <button class="loader-skip" type="button" data-loader-skip>Skip</button>
    </div>
    <a class="skip" href="#main">Skip to content</a>
    <DemoStrip number="05" />
    <header class="bar">
      <a class="brand" href="#menu" data-wipe
        ><svg aria-hidden="true"><use href="#i-cup"></use></svg><span data-business>{c.name}</span
        ></a
      >
      <nav aria-label="Juice bar">
        <a href="#menu" data-wipe>Menu</a><a href="#build" data-wipe>Build</a><a
          href="#collect"
          data-wipe>Collect</a
        ><a href="#find">Find us</a>
      </nav>
      <a class="button small" href="#build" data-order>Order ahead</a>
    </header>
    <div class="stage" data-stage aria-hidden="true"></div>
    <main id="main">
      <section class="scene" id="menu" data-scene-name="menu" aria-label="Menu">
        <div class="hero wrap" data-capture="hero">
          <div class="hero-copy">
            <h1>
              <span>{c.hero.title[0]}</span>
              <span class="pop">{c.hero.title[1]}</span>
            </h1>
            <p class="lead">
              {c.hero.lead[0]}{' '}<span data-area>{c.area}</span>. {c.hero.lead[1]}
            </p>
            <a class="button big" href="#build" data-order
              >Build your cup <svg aria-hidden="true"><use href="#i-blend"></use></svg></a
            >
          </div>
          <div
            class="cup-slot hero-slot"
            data-anchor="hero"
            tabindex="0"
            role="img"
            aria-label="A 3D cup of Mango Marge with a stripy straw. Drag, swipe or use the arrow keys to spin it."
            data-drag
          >
            <img
              class="poster"
              data-drink-poster
              src={assets + 'cup-marge.webp'}
              width="720"
              height="900"
              alt=""
              fetchpriority="high"
            />
            <p class="spin" aria-hidden="true">
              <svg viewBox="0 0 70 54"><use href="#i-arrow"></use></svg>Go on, give it a spin
            </p>
          </div>
        </div>
        <svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"
          ><path d="M0 46C160 10 300 10 460 40s300 36 470 4 330-32 510 8V90H0z"></path><path
            class="wave-line"
            d="M0 46C160 10 300 10 460 40s300 36 470 4 330-32 510 8"></path></svg
        >
        <section class="menu" aria-labelledby="menu-title" data-capture="menu">
          <div class="wrap menu-layout">
            <div class="menu-copy">
              <h2 id="menu-title">Six regulars.<br />Say hello.</h2>
              <p class="intro">
                Ask for them by first name. Everything’s blended when you order, so nothing’s been
                sitting about.
              </p>
              <ol class="drinks" data-drinks>
                {
                  c.menu.map((drink, i) => (
                    <li style={`--drink:${drink.colour}`}>
                      <button
                        type="button"
                        class="drink"
                        data-drink={i}
                        aria-pressed={i === 0 ? 'true' : 'false'}
                      >
                        <span class="drink-name">{drink.name}</span>
                        <span class="drink-what">{drink.ingredients}</span>
                        <span class="drink-line">{drink.line}</span>
                      </button>
                    </li>
                  ))
                }
              </ol>
              <p class="allergens">{c.allergens}</p>
            </div>
            <div class="menu-cup">
              <div class="cup-slot" data-anchor="menu">
                <img
                  class="poster"
                  data-drink-poster
                  src={assets + 'cup-marge.webp'}
                  width="720"
                  height="900"
                  alt="Mango Marge in a cup with a stripy straw."
                  loading="lazy"
                />
              </div>
              <p class="now" aria-live="polite">
                In the cup: <strong data-drink-name>{c.menu[0].name}</strong>
              </p>
            </div>
          </div>
        </section>
        <section class="layers" aria-labelledby="layers-title" data-layers>
          <div class="layers-pin">
            <h2 id="layers-title">What’s in the cup</h2>
            <div class="cup-slot layers-slot" data-anchor="layers">
              <img
                class="poster"
                src={assets + 'cup-layers.webp'}
                width="720"
                height="900"
                alt="A cup pulled apart into four layers: fruit, base, boost and topping."
                loading="lazy"
              />
            </div>
            <ol class="layer-labels">
              {
                c.layers.map(([name, text], i) => (
                  <li data-layer={i}>
                    <strong>{name}</strong>
                    <span>{text}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>
      </section>

      <section class="scene build" id="build" data-scene-name="build" aria-labelledby="build-title">
        <div class="wrap build-layout" data-capture="build">
          <div class="build-cup">
            <div class="cup-slot" data-anchor="build">
              <FlatCup id="flat-build" />
            </div>
            <p class="cup-name" aria-live="polite">
              <small>Your cup is called</small>
              <strong data-cup-name>Pick some fruit</strong>
            </p>
          </div>
          <form class="panel" data-builder novalidate>
            <h2 id="build-title" tabindex="-1">Build your cup</h2>
            <p class="panel-intro">Tap up to four. We’ll blend it into one colour at the end.</p>
            <fieldset class="step">
              <legend>
                Fruit and veg <span class="count" data-fruit-count>· 0 of 4</span>
              </legend>
              <button class="undo" type="button" data-undo aria-disabled="true"
                ><svg aria-hidden="true"><use href="#i-undo"></use></svg>Undo</button
              >
              <div class="fruits">
                {
                  fruits.map((fruit) => (
                    <button
                      type="button"
                      class="fruit"
                      data-fruit={fruit.id}
                      aria-label={`Add ${fruit.label.toLowerCase()}`}
                    >
                      <svg aria-hidden="true">
                        <use href={`#i-${fruit.id}`} />
                      </svg>
                      <span aria-hidden="true">{fruit.label}</span>
                      <b class="badge" aria-hidden="true" />
                    </button>
                  ))
                }
              </div>
            </fieldset>
            <fieldset class="step">
              <legend>Base</legend>
              <div class="choices">
                {
                  c.bases.map((base, i) => (
                    <label>
                      <input type="radio" name="base" value={base} checked={i === 0} />
                      <span>{base}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <fieldset class="step">
              <legend>One boost <span class="count">· flavour, not magic</span></legend>
              <div class="choices">
                {
                  c.boosts.map((boost, i) => (
                    <label>
                      <input type="radio" name="boost" value={boost} checked={i === 0} />
                      <span>{boost}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <div class="go">
              <button class="button" type="submit" data-blend disabled
                >Blend it <svg aria-hidden="true"><use href="#i-blend"></use></svg></button
              >
              <a class="button ghost" href="#collect" data-to-collect data-wipe hidden
                >Pick a collection time <svg aria-hidden="true"><use href="#i-next"></use></svg></a
              >
              <p class="small">Demo: nothing is ordered or paid.</p>
            </div>
            <p class="sr-only" data-builder-status role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>

      <section
        class="scene collect"
        id="collect"
        data-scene-name="collect"
        aria-labelledby="collect-title"
      >
        <div class="wrap collect-layout" data-capture="collect">
          <div class="collect-cup">
            <div class="cup-slot" data-anchor="collect">
              <FlatCup id="flat-collect" lid />
            </div>
          </div>
          <div class="collect-copy">
            <h2 id="collect-title" tabindex="-1">Pick it up</h2>
            <p class="lead" data-collect-intro>
              Choose a time and skip the queue. We’ll have it on the counter with your name on it.
            </p>
            <form class="times" data-times novalidate>
              <fieldset>
                <legend>Collection time</legend>
                <div class="choices">
                  {
                    c.times.map((time, i) => (
                      <label>
                        <input type="radio" name="time" value={time} checked={i === 0} />
                        <span>{time}</span>
                      </label>
                    ))
                  }
                </div>
              </fieldset>
              <button class="button" type="submit"
                >Get my ticket <svg aria-hidden="true"><use href="#i-next"></use></svg></button
              >
            </form>
            <article class="ticket" data-ticket hidden aria-labelledby="ticket-title" tabindex="-1">
              <header>
                <span data-business>{c.name}</span>
                <span data-ticket-number>No. 042</span>
              </header>
              <h3 id="ticket-title" data-ticket-drink>Your cup</h3>
              <dl>
                <div><dt>In it</dt><dd data-ticket-fruit>Mango</dd></div>
                <div><dt>Base</dt><dd data-ticket-base>Apple juice</dd></div>
                <div><dt>Boost</dt><dd data-ticket-boost>Fresh mint</dd></div>
                <div><dt>Collect</dt><dd data-ticket-time>In 10 minutes</dd></div>
              </dl>
              <p class="ticket-demo"><strong>Demo: nothing is ordered or paid.</strong></p>
              <svg class="stamp" viewBox="0 0 120 120" aria-hidden="true"
                ><use href="#i-stamp"></use></svg
              >
            </article>
            <p class="ticket-actions" data-ticket-actions hidden>
              <a class="text-link" href="#build" data-order>Build another cup</a>
            </p>
          </div>
        </div>
      </section>

      <section class="find" id="find" aria-labelledby="find-title" data-capture="contact">
        <div class="wrap find-layout">
          <div class="find-copy">
            <h2 id="find-title">Come and find us</h2>
            <p class="lead">
              <span data-business>{c.name}</span>, {c.address[0]}, <span data-area>{c.area}</span>.{
                ' '
              }{c.address[1]}.
            </p>
            <div class="call">
              <a class="button" href={'tel:' + c.phone.tel} data-call
                ><svg aria-hidden="true"><use href="#i-phone"></use></svg>Call <span data-phone
                  >{c.phone.display}</span
                ></a
              ><a
                class="button ghost"
                href={'https://wa.me/' + c.phone.international}
                data-whatsapp
                rel="noopener"
                ><svg aria-hidden="true"><use href="#i-chat"></use></svg>WhatsApp us</a
              >
            </div>
            <h3>Opening hours</h3>
            <dl class="hours">
              {
                c.hours.map(([day, hours]) => (
                  <div>
                    <dt>{day}</dt>
                    <dd>{hours}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <figure class="map">
            <svg
              viewBox="0 0 560 420"
              role="img"
              aria-label="Hand-drawn street map with a pin on Market Arcade, two doors down from the bakery."
            >
              <use href="#i-map"></use>
            </svg>
            <figcaption>
              <strong>Market Arcade</strong>
              <span>Look for the yellow door.</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="agency" aria-labelledby="agency-title">
        <div class="wrap">
          <p class="agency-kicker">Tumble Cup · juice-bar-05 · by FinTaxTech</p>
          <h2 id="agency-title">Want this for <span data-business>{c.name}</span>?</h2>
          <p>Your name, your drinks and your hours, in a website people actually play with.</p>
          <div class="agency-actions">
            <a
              class="button"
              href="/client/website-brief/templates/?template=juice-bar-05"
              data-brief-link>Talk to FinTaxTech</a
            ><a class="text-link" href="/contact/" data-agency-link>Ask a question first</a>
          </div>
        </div>
      </section>
      <noscript
        ><p class="wrap noscript">
          The drink builder needs JavaScript. Everything else on this page works without it. <a
            href="/contact/">Discuss your website with FinTaxTech.</a
          >
        </p></noscript
      >
    </main>
    <footer class="footer" data-footer>
      <div class="splash" aria-hidden="true">
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none"
          ><path d="M0 64C200 34 360 34 520 60s340 30 520 0 300-30 400-6V120H0z"></path><path
            class="splash-line"
            d="M0 64C200 34 360 34 520 60s340 30 520 0 300-30 400-6"></path></svg
        >
        <i></i><i></i><i></i><i></i><i></i>
      </div>
      <div class="wrap footer-inner">
        <a class="brand" href="#menu"
          ><svg aria-hidden="true"><use href="#i-cup"></use></svg><span data-business>{c.name}</span
          ></a
        >
        <p>Website template by FinTaxTech. Fictional business for demonstration.</p>
        <a href={threeDGallery.route}>Browse 3D templates ↗</a>
      </div>
    </footer>
    <div class="wipe" data-wipe-layer aria-hidden="true">
      <svg viewBox="0 0 100 120" preserveAspectRatio="none"
        ><path d="M0 12C15 0 30 0 50 10s35 10 50 0V108C85 120 70 120 50 110S15 100 0 108z"
        ></path></svg
      >
    </div>
    <NameDialog
      title="Put your name on the cup"
      placeholder="e.g. Tayside Juice Co"
      restoreLabel="Back to Tumble Cup"
    />
    <script is:inline src="/templates/website/3d/_shared/name-dialog.js" data-busy="#build"
    ></script>
    <script>
      import './_runtime/page';
    </script>
  </body>
</html>
