---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { templateCategories, templateDirectory } from '../../content/templates';

export function getStaticPaths() {
  return templateCategories
    .filter(({ service }) => service === 'mobile-apps')
    .map(({ service, title }) => ({
      params: { category: service },
      props: { title },
    }));
}
const { title } = Astro.props;
---

<SiteLayout
  title={`${title} templates`}
  description={`FinTaxTech is uploading its ${title.toLowerCase()} templates.`}
  noindex
  standalone
>
  <div class="placeholder"><h1>{templateDirectory.pendingMessage}</h1></div>
</SiteLayout>

<style>
  .placeholder {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    text-align: center;
  }
  h1 {
    font-size: var(--h2);
  }
</style>
