---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import {
  templateBriefCopy as c,
  templateBriefRedirect as r,
  templateChoices,
} from '../../../../content/template-brief';
// Links shared before the brief moved to one page keep working: each opens
// the brief with ?template=<id>, keeping name, area, phone, ref, role and type.
export function getStaticPaths() {
  return templateChoices.map((template) => ({ params: { template: template.id } }));
}
const { template } = Astro.params;
const destination = `${c.route}?template=${template}`;
---

<SiteLayout title={r.title} description={r.message} noindex>
  <section class="container page-head">
    <h1>{r.title}</h1>
    <p class="lead">{r.message}</p>
    <a class="button primary" href={destination} data-template-redirect={template}>{r.label}</a>
  </section>
  <script is:inline>
    const link = document.querySelector('[data-template-redirect]');
    if (link) {
      const target = new URL(link.getAttribute('href'), window.location.origin);
      new URLSearchParams(window.location.search).forEach((value, key) => {
        if (key !== 'template') target.searchParams.set(key, value);
      });
      link.setAttribute('href', target.pathname + target.search);
      window.location.replace(target.pathname + target.search);
    }
  </script>
</SiteLayout>
