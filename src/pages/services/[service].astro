---
import ServiceHeroVisual from '../../components/ServiceHeroVisual.astro';
import ServiceOutcomeFlow from '../../components/ServiceOutcomeFlow.astro';
import '../../styles/home-motion.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { services, serviceCopy as c } from '../../content/services';
import { ui, home } from '../../content/site';
export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.id }, props: { service } }));
}
const { service: s } = Astro.props;
---

<SiteLayout title={s.name} description={s.description}
  ><div class="container">
    <header class="page-head service-page-hero">
      <div class="service-heading-copy">
        <p class="eyebrow">{s.number} / {s.name}</p><h1>{s.title}</h1><p class="lead">
          {s.intro ?? s.description}
        </p>
        {s.serviceArea && <p>{s.serviceArea}</p>}
        <div class="actions">
          <a class="button primary" href={`/enquiry/?service=${s.id}`}>{c.lead}</a>
        </div>
      </div><ServiceHeroVisual service={s.id} />
    </header><div class="split section">
      <h2>{c.capabilities}</h2><ul>{s.capabilities.map((x) => <li>{x}</li>)}</ul>
    </div><div class="split section"><h2>{c.suits}</h2><p>{s.suits}</p></div><div
      class="split section"
    >
      <h2>{c.boundary}</h2><p>{s.boundary}</p>
    </div><section class="section">
      <div class="split"><h2>{c.process}</h2><p>{c.processText}</p></div><ServiceOutcomeFlow
        service={s.id}
      />
    </section><div class="split section">
      <h2>{c.ownership}</h2><p>{s.ownership}</p>
    </div><section class="section">
      <h2>{c.faq}</h2>{
        home.faqs.slice(1, 3).map(([q, a]) => (
          <details>
            <>
              <summary>{q}</summary>
              <p>{a}</p>
            </>
          </details>
        ))
      }
    </section><section class="section">
      <h2>{c.brief}</h2><p>{c.briefText}</p><div class="actions">
        <a class="button" href={`/enquiry/?service=${s.id}&stage=2`}>{c.brief}</a><a
          class="button primary"
          href={`/enquiry/?service=${s.id}`}>{ui.requirements}</a
        >
      </div>
    </section>
    <p><a href="/start/">{ui.choose}</a></p>
  </div></SiteLayout
>

<script>
  // The same once-per-page controller used by Phase 1; no additional observer.
  import '../../scripts/home-motion';
</script>
<style>
  .service-page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    max-width: none;
    align-items: center;
  }
  .service-heading-copy {
    min-width: 0;
  }
  @media (--selector-desktop) {
    .service-page-hero {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
