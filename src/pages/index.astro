---
import SiteLayout from '../layouts/SiteLayout.astro';
import Mark from '../components/Mark.astro';
import ServiceSelector from '../components/ServiceSelector.astro';
import FinalCTA from '../components/FinalCTA.astro';
import LatestArticles from '../components/blog/LatestArticles.astro';
import { company, ui, home as c } from '../content/site';
import HomeWork from '../components/HomeWork.astro';
import { pages } from '../content/pages';
---

<SiteLayout title={company.tagline}>
  <section class="container hero">
    <div>
      <p class="eyebrow">{company.tagline}</p><h1>{c.title}</h1><p class="lead">{c.intro}</p><p
        class="muted hero-location"
      >
        {c.serviceArea}
      </p><div class="actions">
        <a class="button primary" href="#choose">{ui.choose}</a><a
          class="button"
          href="/how-it-works/">{ui.how}</a
        >
      </div>
    </div><div class="hero-art">
      <div class="hero-mark" role="img" aria-label={ui.markAlt}><Mark /></div>
    </div>
  </section>
  <ServiceSelector id="choose" />
  <section class="section">
    <div class="container split">
      <div><p class="eyebrow">{c.why}</p><h2>{c.whyTitle}</h2></div><div>
        {
          c.reasons.map(([title, text]) => (
            <article class="reason">
              <>
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{ui.process}</p><h2>{c.processTitle}</h2><ol class="steps">
        {c.steps.map((s) => <li>{s}</li>)}
      </ol><p class="muted">{c.pdfNotice}</p>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <h2>{c.priceTitle}</h2><div>
        <p class="lead">{c.priceText}</p><a class="text-link" href="/pricing/"
          >{pages.pricing.title} →</a
        >
      </div>
    </div>
  </section>
  <HomeWork />
  <section class="section">
    <div class="container">
      <h2>{c.faqTitle}</h2>{
        c.faqs.map(([q, a]) => (
          <details>
            <>
              <summary>{q}</summary>
              <p>{a}</p>
            </>
          </details>
        ))
      }
    </div>
  </section><LatestArticles /><FinalCTA />
</SiteLayout>

<style>
  .hero-location {
    font-size: var(--small);
    max-width: 56ch;
  }
  @media (--tablet) {
    .hero {
      grid-template-columns: 1.8fr 1fr;
    }
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
