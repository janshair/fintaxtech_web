---
import SiteLayout from '../layouts/SiteLayout.astro';
import { formGroups, formsDirectory } from '../content/forms';

const icons = {
  branding:
    'M12 3 20 13l-4 8H8l-4-8 8-10Zm0 0v8m-4 6h8 M13.5 12.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 1 1 3 0Z',
  websites: 'M4 4h16q1 0 1 1v14q0 1-1 1H4q-1 0-1-1V5q0-1 1-1Zm-1 5h18 M6 6.5h.1m3 0h.1',
  'mobile-apps': 'M8 2h8q2 0 2 2v16q0 2-2 2H8q-2 0-2-2V4q0-2 2-2Zm2 3h4m-3 14h2',
  'ai-automation': 'M9 2h6v6H9z M2 16h7v6H2z M15 16h7v6h-7z M12 8v4m-6.5 4v-4h13v4',
};
---

<SiteLayout title={formsDirectory.title} description={formsDirectory.description}>
  <div class="container directory">
    <h1>{formsDirectory.title}</h1>
    <p class="lead">{formsDirectory.description}</p>
    <div class="groups">
      {
        formGroups.map(({ service, title, links }) => (
          <section aria-labelledby={service}>
            <h2 id={service}>
              <span class="icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="28"
                  height="28"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                >
                  <path d={icons[service]} />
                </svg>
              </span>
              {title}
            </h2>
            <ul role="list">
              {links.map(([label, href]) => (
                <li>
                  <a href={href}>
                    {label}
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</SiteLayout>

<style>
  .directory {
    padding-block: var(--space-6) var(--space-9);
  }
  .lead {
    margin-block: var(--space-4) var(--space-6);
  }
  .groups {
    display: grid;
    gap: var(--space-5);
  }
  section {
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--space-3);
  }
  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--space-2);
    background: var(--soft);
    color: var(--accent);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 2.75rem;
    padding-block: var(--space-2);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  a:is(:hover, :focus-visible) {
    text-decoration: underline;
  }
  @media (--tablet) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
