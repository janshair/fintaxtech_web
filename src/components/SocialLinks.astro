---
import { socialCopy, socialProfiles } from '../content/social';
interface Props {
  location?: 'footer' | 'contact';
}
const { location = 'contact' } = Astro.props;
---

<nav
  class="social-links"
  aria-label={location === 'footer' ? socialCopy.footerNavigation : socialCopy.navigation}
>
  <ul>
    {
      socialProfiles.map((profile) => (
        <li>
          <a href={profile.url} target="_blank" rel="noopener noreferrer">
            <>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
                focusable="false"
              >
                <>
                  <rect x="3" y="3" width="18" height="18" rx="4" />
                  <path d="M8 16 16 8M8 8h8v8" />
                </>
              </svg>
              <span>{profile.label}</span>
            </>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<style>
  .social-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    list-style: none;
    padding: 0;
    margin-block: var(--space-5);
  }
  .social-links li {
    margin: 0;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--space-7);
  }
  .social-links svg {
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
  }
</style>
