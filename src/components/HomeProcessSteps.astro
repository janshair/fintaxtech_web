---
import { home } from '../content/site';
---

<ol class="steps home-process-steps home-motion" data-home-motion>
  {
    home.steps.map((step, i) => (
      <li>
        <span class="step-content">
          <span class="step-number" aria-hidden="true" />
          <span
            class="step-label"
            style={`--step-delay:${i * 1080}ms`}
            data-motion-end={i === home.steps.length - 1 ? '' : undefined}
          >
            {step}
          </span>
        </span>
        {i < home.steps.length - 1 && (
          <svg
            class="step-connection"
            style={`--step-delay:${i * 1080 + 480}ms`}
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            width="100"
            height="100"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M0 0 100 100" vector-effect="non-scaling-stroke" />
          </svg>
        )}
      </li>
    ))
  }
</ol>
<style>
  .home-process-steps {
    grid-template-columns: 1fr;
    gap: 0;
    margin-block: var(--space-6);
  }
  .home-process-steps li {
    position: relative;
    border: 0;
    padding: 0 0 var(--space-6);
  }
  .home-process-steps li:last-child {
    padding: 0;
  }
  .home-process-steps li::before {
    content: none;
  }
  .step-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .step-label {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
  }
  .step-number {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    font: var(--weight-strong) var(--body) var(--font-mono);
  }
  .step-number::before {
    content: counter(step);
  }
  .step-connection {
    position: absolute;
    /* This connector deliberately spans the grid gap to the next dot. */
    max-width: none;
    left: 1.25rem;
    top: 1.25rem;
    width: 1px;
    height: 100%;
    transform-origin: top center;
    --connection-start: scaleY(0);
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    overflow: visible;
  }
  @media (--tablet) {
    .home-process-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
    .home-process-steps li {
      padding: 0;
    }
    .step-content {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      padding-right: var(--space-4);
    }
    .step-connection {
      left: 1.25rem;
      top: 1.25rem;
      width: calc(100% + var(--space-5));
      height: 1px;
      transform-origin: left center;
      --connection-start: scaleX(0);
    }
  }
  /* Animate a solid connector, not SVG dashes: non-scaling strokes and
     stretched view boxes otherwise produce separated dash segments. */
  @media (prefers-reduced-motion: no-preference) {
    .home-process-steps:is([data-motion-state='running'], [data-motion-state='paused'])
      .step-connection {
      animation: process-connect 600ms ease-in-out var(--step-delay) both;
    }
    .home-process-steps:is([data-motion-state='running'], [data-motion-state='paused'])
      .step-label {
      animation: process-label 400ms ease-out var(--step-delay) both;
    }
    .home-process-steps[data-motion-state='paused'] :is(.step-connection, .step-label) {
      animation-play-state: paused;
    }
  }
  @keyframes process-connect {
    from {
      transform: var(--connection-start);
    }
    to {
      transform: none;
    }
  }
  @keyframes process-label {
    from {
      clip-path: inset(0 100% 0 0);
      transform: translateY(6px);
    }
    to {
      clip-path: inset(0);
      transform: none;
    }
  }
</style>
