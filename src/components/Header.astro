---
interface Props {
  startHref?: string;
}
const { startHref = '/start/' } = Astro.props;
import Mark from './Mark.astro';
import { company, ui, navigation } from '../content/site';
import { assistantCopy } from '../content/project-assistant';
---

<a class="skip" href="#main">{ui.skip}</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/"><span class="brand-mark"><Mark /></span>{company.name}</a>
    <nav id="main-navigation" class="main-nav" aria-label={ui.nav}>
      {
        navigation
          .filter(([href]) => href !== '/templates/website/motion/')
          .map(([href, label]) => (
            <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>
              {label}
            </a>
          ))
      }
    </nav>
    <button class="button theme-button" id="theme-toggle" aria-label={ui.theme} title={ui.theme}
      ><span aria-hidden="true">◐</span></button
    >
    <button
      class="button menu-toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="main-navigation">{ui.menu}</button
    >
    <button
      class="button primary header-cta"
      type="button"
      data-assistant-open
      aria-haspopup="dialog"
      aria-controls="project-assistant"
      hidden>{assistantCopy.launcher}</button
    >
    <noscript
      ><a class="button primary header-cta" href={startHref}>{assistantCopy.launcher}</a></noscript
    >
  </div>
</header>
