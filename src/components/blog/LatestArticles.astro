---
import ArticleList from './ArticleList.astro';
import { getPublishedPosts } from '../../lib/blog';
import { blogCopy } from '../../content/blog';
const posts = (await getPublishedPosts()).slice(0, 3);
---

{
  posts.length > 0 && (
    <section class="section" aria-labelledby="latest-articles">
      <div class="container">
        <h2 id="latest-articles">{blogCopy.latest}</h2>
        <ArticleList posts={posts} heading="h3" />
        <p class="actions">
          <a class="text-link" href="/blog/">
            {blogCopy.all} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>
  )
}
