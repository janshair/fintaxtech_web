---
interface Props {
  category: string;
  tags: string[];
}
const { category, tags } = Astro.props;
const destinations = [
  {
    category: 'Branding and Graphic Design',
    tags: ['branding', 'logo design', 'brand identity'],
    text: 'Bring your business identity together with logo and brand design from FinTaxTech.',
    label: 'Explore branding',
    href: '/services/branding/',
  },
  {
    category: 'Website Design and Development',
    tags: ['websites', 'website design', 'web development'],
    text: 'See how a phone-first website could look with your own business name.',
    label: 'Browse animated website templates',
    href: '/templates/website/motion/',
  },
  {
    category: 'AI Automation',
    tags: ['ai', 'ai automation', 'automation'],
    text: 'Talk through the admin tasks you want to automate and the tools you already use.',
    label: 'Explore AI automation',
    href: '/services/ai-automation/',
  },
  {
    category: 'Mobile App Development',
    tags: ['mobile apps', 'app development', 'ios', 'android'],
    text: 'Discuss what your iOS or Android app needs to do for the people who will use it.',
    label: 'Explore app development',
    href: '/services/mobile-apps/',
  },
];
const next = destinations.find((item) => item.category === category) ??
  destinations.find((item) => tags.some((tag) => item.tags.includes(tag.toLowerCase()))) ?? {
    text: 'Tell us what you would like to make or improve.',
    label: 'Start your project',
    href: '/start/',
  };
---

<aside class="container" aria-labelledby="blog-next-title">
  <div class="notice next-box">
    <h2 id="blog-next-title">What next?</h2>
    <p>{next.text}</p>
    <a class="button primary" href={next.href}>{next.label}</a>
  </div>
</aside>

<style>
  .next-box {
    margin-block: var(--space-7);
    padding: var(--space-6);
  }
</style>
