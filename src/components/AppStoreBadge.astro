---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="app-store-badge" href={href} target="_blank" rel="noopener noreferrer">
  <img
    src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
    alt={label}
    width="120"
    height="40"
    decoding="async"
  />
</a>

<style>
  .app-store-badge {
    display: inline-block;
    width: calc(var(--store-badge-width) * 0.84);
    max-width: 100%;
    align-self: flex-start;
    flex-shrink: 0;
    margin: calc(var(--store-badge-width) * 0.06) calc(var(--store-badge-width) * 0.08);
    border-radius: var(--radius);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
