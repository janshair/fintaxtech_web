---
import { heroProcess as c } from '../content/home-motion';
import ServiceGlyph from './ServiceGlyph.astro';
---

<figure class="hero-process home-motion" data-home-motion role="img" aria-label={c.label}>
  <div class="process-inputs">
    {
      c.services.map((service, i) => (
        <div class="input-position">
          <div class="input-card motion-part" style={`--motion-order:${i}`}>
            <>
              <ServiceGlyph service={service.id} />
              <span>{service.label}</span>
            </>
            <span class="input-dot" aria-hidden="true" />
          </div>
        </div>
      ))
    }
  </div>
  <div class="brief-paths" aria-hidden="true">
    <svg
      class="wide-paths"
      viewBox="0 0 100 320"
      preserveAspectRatio="none"
      width="100"
      height="320"
      focusable="false"
    >
      {
        [40, 120, 200, 280].map((y, i) => (
          <path
            class="motion-stroke"
            style={`--motion-order:${5 + i}`}
            d={`M0 ${y} C50 ${y},45 ${70 + i * 58},100 ${70 + i * 58}`}
            pathLength="1"
          />
        ))
      }
    </svg>
    <svg
      class="stacked-paths"
      viewBox="0 0 360 90"
      preserveAspectRatio="none"
      width="360"
      height="90"
      focusable="false"
    >
      {
        [35, 120, 240, 325].map((x, i) => (
          <path
            class="motion-stroke"
            style={`--motion-order:${5 + i}`}
            d={`M${x} 0 C${x} 65,${150 + i * 20} 25,${150 + i * 20} 90`}
            pathLength="1"
          />
        ))
      }
    </svg>
  </div>
  <div class="brief-document">
    <div class="document-trail trail-one" aria-hidden="true"></div>
    <div class="document-trail trail-two" aria-hidden="true"></div>
    <div class="document-face">
      <span class="brief-title">{c.brief}</span>
      <div class="brief-rows">
        {
          c.services.map((service, i) => (
            <div class="brief-row motion-part" style={`--motion-order:${9 + i}`}>
              <ServiceGlyph service={service.id} />
              <span class="row-copy" aria-hidden="true">
                <>
                  <i />
                  <i />
                </>
              </span>
              <span class="row-dot" aria-hidden="true" />
            </div>
          ))
        }
      </div>
      <div class="review-mark motion-part" style="--motion-order:15" data-motion-end>
        <span
          class="approval-icon motion-part"
          style="--motion-order:15;--motion-opacity:0"
          aria-hidden="true"
          ><svg viewBox="0 0 32 32" width="32" height="32" focusable="false"
            ><path d="m8 16 5 5 11-12"></path></svg
          ></span
        >
        <span>{c.review}</span>
      </div>
    </div>
  </div>
</figure>
<style>
  .hero-process {
    margin: 0;
    width: 100%;
    max-width: 36rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    isolation: isolate;
    padding: var(--space-4);
  }
  .process-inputs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .input-position {
    min-width: 0;
  }
  .input-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 4rem;
    padding: var(--space-3) var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font: var(--weight-strong) var(--caption)/var(--line-control) var(--font-heading);
    box-shadow: -4px 4px 0 var(--soft);
  }
  .input-card :global(svg) {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    color: var(--text);
  }
  .input-dot {
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
    margin-left: auto;
    flex: none;
  }
  .brief-paths {
    height: 4rem;
  }
  .brief-paths svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .brief-paths .wide-paths {
    display: none;
  }
  .brief-document {
    position: relative;
    width: 100%;
    max-width: 18rem;
    justify-self: center;
  }
  .document-trail {
    position: absolute;
    inset: 0;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    opacity: 0.25;
    z-index: -1;
  }
  .trail-one {
    transform: translate(5px, -5px);
  }
  .trail-two {
    transform: translate(10px, -10px);
  }
  .document-face {
    background: var(--surface);
    border: 1px solid var(--muted);
    border-radius: var(--radius);
    padding: var(--space-4);
  }
  .brief-title {
    display: block;
    font: var(--weight-strong) var(--small)/var(--line-control) var(--font-heading);
    margin-bottom: var(--space-4);
  }
  .brief-rows {
    display: grid;
    gap: var(--space-2);
  }
  .brief-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    background: var(--bg);
  }
  .brief-row :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }
  .row-copy {
    flex: 1;
    display: grid;
    gap: 5px;
  }
  .row-copy i {
    height: 4px;
    background: var(--muted);
    opacity: 0.35;
    border-radius: 2px;
  }
  .row-copy i:last-child {
    width: 65%;
  }
  .row-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .review-mark {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font: var(--weight-strong) var(--caption)/var(--line-control) var(--font-body);
  }
  .approval-icon {
    width: 2rem;
    height: 2rem;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .approval-icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (--tablet) {
    .hero-process {
      grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1.05fr);
      min-height: 24rem;
    }
    .process-inputs {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .input-card {
      min-height: 4rem;
    }
    .input-position:nth-child(odd) {
      transform: rotate(-3deg);
    }
    .input-position:nth-child(even) {
      transform: rotate(2deg);
    }
    .brief-paths {
      height: 20rem;
    }
    .brief-paths .wide-paths {
      display: block;
    }
    .brief-paths .stacked-paths {
      display: none;
    }
    .brief-document {
      max-width: none;
    }
  }
</style>
