---
import { ui, selectorCopy } from '../content/site';
interface Props {
  mode?: 'information' | 'questionnaire';
  layout?: 'inline' | 'stacked';
}
const { mode = 'information', layout = 'inline' } = Astro.props;
---

<div class={layout === 'inline' ? 'unsure' : undefined}>
  <a href="/start/?route=help" data-start-routing={mode === 'questionnaire' ? '' : undefined}>
    {ui.notSure}
    <span aria-hidden="true">{` ${selectorCopy.helpArrow}`}</span>
  </a>
  {layout === 'inline' ? <span class="muted">{ui.routeHelp}</span> : <p>{ui.routeHelp}</p>}
</div>
