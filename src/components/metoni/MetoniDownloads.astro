---
import { metoni } from '../../content/metoni';
import GooglePlayBadge from '../GooglePlayBadge.astro';
interface Props {
  appStoreURL?: string;
}
const { appStoreURL = metoni.appStoreURL } = Astro.props;
---

<div class="actions">
  <GooglePlayBadge href={metoni.playStoreURL} label={metoni.playLabel} />
  {
    appStoreURL && (
      <a class="button" href={appStoreURL} target="_blank" rel="noopener noreferrer">
        {metoni.appStoreLabel}
      </a>
    )
  }
</div>
<p class="muted platform-status">
  {metoni.androidStatus}<br />{appStoreURL ? metoni.iosAvailableStatus : metoni.iosStatus}
</p>
<style>
  .platform-status {
    margin-top: var(--space-4);
  }
</style>
