---
import { Image } from 'astro:assets';
import desktop from '../assets/work/ask-appliance-repairs-desktop.webp';
import mobile from '../assets/work/ask-appliance-repairs-mobile.webp';
import { featuredWork as work, publishedApps, workCopy } from '../content/work';
---

<section class="section work-showcase" aria-labelledby="featured-work-title">
  <div class="work-showcase-head">
    <div class="work-showcase-intro">
      <p class="eyebrow">{work.category}</p>
      <h2 id="featured-work-title">{work.name}</h2>
      <p>{work.summary}</p>
      <a
        class="button"
        href={work.url}
        data-external-project
        target="_blank"
        rel="noopener noreferrer"
      >
        {work.visitLabel} ↗
      </a>
    </div>
    <figure class="work-feedback">
      <p class="work-feedback-label">{work.feedback.label}</p>
      <blockquote>{work.feedback.quote}</blockquote>
      <figcaption>
        <span class="work-feedback-attribution">{work.feedback.attribution}</span>
        <span>{work.feedback.disclosure}</span>
      </figcaption>
    </figure>
  </div>
  <div class="work-previews">
    <figure>
      <a class="work-preview work-preview-desktop" href={desktop.src}>
        <Image src={desktop} alt={work.desktopAlt} loading="eager" decoding="async" />
      </a>
      <figcaption>{work.desktopCaption}</figcaption>
    </figure>
    <figure>
      <a class="work-preview work-preview-mobile" href={mobile.src}>
        <Image src={mobile} alt={work.mobileAlt} loading="eager" decoding="async" />
      </a>
      <figcaption>{work.mobileCaption}</figcaption>
    </figure>
  </div>
</section>

<section class="section" aria-labelledby="published-apps-title">
  <p class="eyebrow">{workCopy.appsEyebrow}</p>
  <h2 id="published-apps-title">{workCopy.appsTitle}</h2>
  <ul class="app-list">
    {
      publishedApps.map((app) => (
        <li class="app-card">
          <div>
            <h3>{'pageURL' in app ? <a href={app.pageURL}>{app.name}</a> : app.name}</h3>
            <p>{app.summary}</p>
          </div>
          {'pageURL' in app && (
            <a class="button primary" href={app.pageURL}>
              {app.pageLabel}
            </a>
          )}
          <a class="button" href={app.playStoreUrl} target="_blank" rel="noopener noreferrer">
            {app.visitLabel} ↗
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .app-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .app-card {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .app-card h3 {
    margin: 0 0 0.5rem;
  }
  .app-card p {
    margin: 0;
    color: var(--muted);
  }
  .app-card .button {
    align-self: flex-start;
  }
</style>
