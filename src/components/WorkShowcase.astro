---
import { Image } from 'astro:assets';
import GooglePlayBadge from './GooglePlayBadge.astro';
import AppStoreBadge from './AppStoreBadge.astro';
import ClientFeedback from './ClientFeedback.astro';
import desktop from '../assets/work/ask-appliance-repairs-desktop.webp';
import mobile from '../assets/work/ask-appliance-repairs-mobile.webp';
import { featuredWork as work, publishedApps, workCopy } from '../content/work';
---

<!-- Finished client work, shown under the "Client projects" heading on /work/. -->
<article class="work-showcase" aria-labelledby="featured-work-title">
  <div class="work-showcase-head">
    <div class="work-showcase-intro">
      <p class="eyebrow">{work.category}</p>
      <h3 id="featured-work-title">{work.name}</h3>
      <p>{work.summary}</p>
      <a
        class="button"
        href={work.url}
        data-external-project
        target="_blank"
        rel="noopener noreferrer"
      >
        {work.visitLabel} ↗
      </a>
    </div>
    <ClientFeedback />
  </div>
  <div class="project-details">
    {
      work.projectDetails.map(([question, answer]) => (
        <section>
          <h4>{question}</h4>
          <p>{answer}</p>
        </section>
      ))
    }
  </div>
  <div class="work-previews">
    <figure>
      <a class="work-preview work-preview-desktop" href={desktop.src}>
        <Image src={desktop} alt={work.desktopAlt} loading="eager" decoding="async" />
      </a>
      <figcaption>{work.desktopCaption}</figcaption>
    </figure>
    <figure>
      <a class="work-preview work-preview-mobile" href={mobile.src}>
        <Image src={mobile} alt={work.mobileAlt} loading="eager" decoding="async" />
      </a>
      <figcaption>{work.mobileCaption}</figcaption>
    </figure>
  </div>
</article>

<section class="published-apps" aria-labelledby="published-apps-title">
  <p class="eyebrow">{workCopy.appsEyebrow}</p>
  <h3 id="published-apps-title">{workCopy.appsTitle}</h3>
  <ul class="app-list">
    {
      publishedApps.map((app) => (
        <li class="app-card">
          <div>
            <h4>
              <a href={app.pageURL}>{app.name}</a>
            </h4>
            <p>{app.summary}</p>
          </div>
          {'pageURL' in app && (
            <a class="button primary" href={app.pageURL}>
              {app.pageLabel}
            </a>
          )}
          <GooglePlayBadge href={app.playStoreUrl} label={app.visitLabel} />
          {'appStoreUrl' in app && (
            <AppStoreBadge href={app.appStoreUrl} label={app.appStoreLabel} />
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work-showcase h3 {
    font-size: var(--h2);
  }
  .work-showcase h4 {
    font-size: var(--h3);
    margin: 0 0 var(--space-3);
  }
  .published-apps {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }
  .app-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .app-card {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .app-card h4 {
    font-size: var(--h3);
    margin: 0 0 0.5rem;
  }
  .app-card p {
    margin: 0;
    color: var(--muted);
  }
  .app-card .button {
    align-self: flex-start;
  }
</style>
