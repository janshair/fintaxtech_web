---
import ServiceCards from './ServiceCards.astro';
import ServiceHelp from './ServiceHelp.astro';
import { selectorCopy } from '../content/site';
interface Props {
  id: string;
  mode?: 'information' | 'questionnaire';
}
const { id, mode = 'information' } = Astro.props;
---

<section class="section service-selector" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{selectorCopy.title}</h2>
    <ServiceCards mode={mode} />
    <ServiceHelp mode={mode} />
  </div>
</section>
