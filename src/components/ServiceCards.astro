---
import { services } from '../content/services';
import ServiceCard from './ServiceCard.astro';
interface Props {
  animated?: boolean;
  headingLevel?: 'h2' | 'h3';
  mode?: 'information' | 'questionnaire';
}
const { mode = 'information', headingLevel = 'h3', animated = false } = Astro.props;
---

<div class="service-grid">
  {
    services.map((service) => (
      <ServiceCard service={service} animated={animated} mode={mode} headingLevel={headingLevel} />
    ))
  }
</div>
