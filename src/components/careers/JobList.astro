---
import type { CollectionEntry } from 'astro:content';
import JobMetadata from './JobMetadata.astro';
import { careersCopy, jobCategories } from '../../content/careers';
import { jobURL } from '../../lib/job-posts';
interface Props {
  jobs: CollectionEntry<'jobs'>[];
}
const { jobs } = Astro.props;
---

{
  jobs.length ? (
    <div data-job-list>
      <div class="job-filters" role="group" aria-label={careersCopy.categoryFilter} hidden>
        <button type="button" class="button primary" data-job-filter="all" aria-pressed="true">
          {careersCopy.allJobs}
        </button>
        {jobCategories.map((category) => (
          <button type="button" class="button" data-job-filter={category} aria-pressed="false">
            {careersCopy.categories[category]}
          </button>
        ))}
      </div>
      <p class="sr-only" role="status" data-job-status data-empty={careersCopy.emptyCategory} />
      <ul class="job-list" role="list">
        {jobs.map((job) => (
          <li data-job-category={job.data.category ?? ''}>
            <article class="job-card">
              <h3>
                <a href={jobURL(job)}>{job.data.title}</a>
              </h3>
              <p>{job.data.summary}</p>
              <JobMetadata data={job.data} />
            </article>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <p>{careersCopy.empty}</p>
  )
}
<script>
  const jobList = document.querySelector('[data-job-list]');
  const filters = jobList?.querySelector<HTMLElement>('.job-filters');
  const status = jobList?.querySelector<HTMLElement>('[data-job-status]');

  if (jobList && filters && status) {
    const buttons = filters.querySelectorAll<HTMLButtonElement>('[data-job-filter]');
    const jobs = jobList.querySelectorAll<HTMLElement>('[data-job-category]');

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const selected = button.dataset.jobFilter;
        for (const option of buttons) {
          option.setAttribute('aria-pressed', String(option === button));
          option.classList.toggle('primary', option === button);
        }

        let visible = 0;
        for (const job of jobs) {
          const matches = selected === 'all' || job.dataset.jobCategory === selected;
          job.hidden = !matches;
          if (matches) visible += 1;
        }

        status.classList.toggle('sr-only', visible > 0);
        status.textContent = visible
          ? `${visible} ${visible === 1 ? 'vacancy' : 'vacancies'} shown.`
          : (status.dataset.empty ?? '');
      });
    }

    filters.hidden = false;
  }
</script>
<style>
  .job-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .job-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }
  li {
    margin: 0;
    min-width: 0;
  }
  .job-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow-wrap: anywhere;
  }
  h3 {
    margin-bottom: var(--space-4);
  }
  p {
    max-width: var(--reading);
  }
</style>
