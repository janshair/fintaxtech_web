// Placeholder Instagram and Pinterest links for wedding-09: no real accounts.
// Without JavaScript they jump to #contact; app.js opens a preview instead.
---

<div class="social-block">
  <div class="social-links">
    <a href="#contact" data-social="instagram"
      ><span class="social-icon" aria-hidden="true"
        ><svg viewBox="0 0 24 24"
          ><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"
          ></circle><circle class="dot" cx="17" cy="7" r="1.1"></circle></svg
        ></span
      >Instagram</a
    ><a href="#contact" data-social="pinterest"
      ><span class="social-icon" aria-hidden="true"
        ><svg viewBox="0 0 24 24"
          ><circle cx="12" cy="12" r="8.5"></circle><path
            d="M11.2 9.2 8.9 19.6M10.2 13.6c.5.5 1.2.8 2 .8 2 0 3.4-1.7 3.4-3.7 0-2-1.6-3.3-3.7-3.3-2.4 0-3.9 1.6-3.9 3.4 0 .7.2 1.3.6 1.8"
          ></path></svg
        ></span
      >Pinterest</a
    >
  </div>
  <p class="social-note">Your Instagram and Pinterest go here</p>
</div>
