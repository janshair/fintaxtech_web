---
// Original illustrations for the Save the Date wedding-supplier demo (wedding-09).
// Brand-coloured parts use f-/s- classes, which read --brand and --accent from
// THEME. Skin, hair, film, gold, sponge and wood are fixed illustration colours.
// Every scene is an illustrated example: no real couples, venues or photos.
// Parts with data-seg="stage from to" are driven by motion.js (it writes --t);
// without it --t falls back to 1, so the finished picture always shows.
import Bloom from './WeddingBloom.astro';
import Couple from './WeddingCouple.astro';
interface Props {
  kind: string;
  tile?: boolean;
}
const { kind, tile } = Astro.props;

// Camera iris: six overlapping wedges that slide out radially to open.
const blades = [0, 60, 120, 180, 240, 300];
// Film strip sprockets and frames.
const sprockets = Array.from({ length: 27 }, (_, i) => 8 + i * 24);
const frames = [0, 1, 2, 3].map((i) => 30 + i * 164);
// Bouquet built stem by stem: each stem draws, then its flower opens.
const bouquet = [
  { x: 228, y: 110, r: 21, kind: 'rose', tone: 'paper' },
  { x: 292, y: 108, r: 21, kind: 'rose', tone: 'accent-deep' },
  { x: 260, y: 86, r: 25, kind: 'peony', tone: 'accent' },
  { x: 244, y: 146, r: 19, kind: 'daisy', tone: 'paper' },
  { x: 282, y: 146, r: 19, kind: 'peony', tone: 'paper' },
  { x: 214, y: 70, r: 12, kind: 'bud', tone: 'accent' },
  { x: 306, y: 66, r: 12, kind: 'bud', tone: 'accent-deep' },
] as const;
const stemCount = bouquet.length;
const stemSeg = (i: number) => {
  const from = (i / stemCount) * 0.82;
  return [
    `2 ${from.toFixed(3)} ${(from + 0.24).toFixed(3)}`,
    `2 ${(from + 0.12).toFixed(3)} ${Math.min(1, from + 0.3).toFixed(3)}`,
  ];
};
const leaves = [
  { x: 232, y: 176, a: -150 },
  { x: 284, y: 176, a: -30 },
  { x: 214, y: 132, a: -170 },
  { x: 304, y: 130, a: -10 },
];
// Cake tiers, bottom first.
const tiers = [
  { x: 95, y: 190, w: 210, h: 68, band: 'brand-soft' },
  { x: 125, y: 132, w: 150, h: 58, band: 'accent-soft' },
  { x: 152, y: 82, w: 96, h: 50, band: 'gold-soft' },
];
const scallop = (x: number, y: number, w: number, size = 10) => {
  const n = Math.max(3, Math.round(w / size));
  const step = w / n;
  let d = `M${x} ${y}`;
  for (let i = 0; i < n; i++)
    d += ` q${(step / 2).toFixed(2)} ${(step * 0.6).toFixed(2)} ${step.toFixed(2)} 0`;
  return d;
};
const petals = Array.from({ length: 9 }, (_, i) => i);
const bulbs = [12, 34, 56, 78, 100, 122, 140];
const confetti = [
  [24, 40, 'accent'],
  [46, 70, 'gold'],
  [150, 36, 'paper'],
  [170, 64, 'accent'],
  [130, 22, 'gold'],
  [34, 110, 'paper'],
  [176, 112, 'gold'],
  [60, 26, 'paper'],
  [96, 30, 'accent'],
  [150, 90, 'accent'],
] as const;
---

{
  kind === 'camera' && (
    <svg class="art camera-art" viewBox="0 0 360 320" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="wd-lens">
          <circle cx="180" cy="190" r="94" />
        </clipPath>
      </defs>
      <rect x="124" y="40" width="112" height="44" rx="12" class="f-brand" />
      <rect x="258" y="52" width="44" height="22" rx="8" class="f-accent" />
      <rect x="20" y="70" width="320" height="230" rx="30" class="f-brand" />
      <rect x="20" y="120" width="320" height="140" class="f-leather" />
      <rect x="44" y="86" width="48" height="18" rx="5" class="f-white" opacity=".55" />
      <circle cx="180" cy="190" r="116" class="f-gold" />
      <circle cx="180" cy="190" r="106" class="f-film" />
      <g clip-path="url(#wd-lens)">
        <rect x="86" y="96" width="188" height="188" class="f-accent-soft" />
        <circle cx="228" cy="142" r="18" class="f-gold-soft" />
        <path d="M86 238c40-30 80-26 110-10 30-18 62-16 78-2v58H86Z" class="f-brand-soft" />
        <path d="M128 284v-72a52 52 0 0 1 104 0v72" class="s-arch" />
        <Bloom x={129} y={226} r={11} tone="paper" />
        <Bloom x={138} y={186} r={12} kind="peony" tone="accent" />
        <Bloom x={162} y={163} r={11} tone="accent-deep" />
        <Bloom x={198} y={163} r={11} kind="daisy" tone="paper" />
        <Bloom x={222} y={186} r={12} kind="peony" tone="paper" />
        <Bloom x={231} y={226} r={11} tone="accent" />
        <Couple x={180} y={280} s={0.92} />
        <g class="iris">
          {blades.map((a) => (
            <g transform={`rotate(${a} 180 190)`}>
              <path class="blade" d="M180 200 70 40h220Z" />
            </g>
          ))}
        </g>
      </g>
      <path d="M116 150a76 76 0 0 1 58-38" class="s-glare" />
    </svg>
  )
}
{
  kind === 'bouquet-hero' && (
    <svg class="art bouquet-hero-art" viewBox="0 0 360 380" aria-hidden="true" focusable="false">
      <g class="s-stems">
        {[148, 160, 172, 184, 196, 208].map((x, i) => (
          <path d={`M${x} 190 L${168 + i * 5} 370`} />
        ))}
      </g>
      <path d="M118 200c-30-30-30-70 4-80 0 34 0 56-4 80Z" class="f-brand-soft" />
      <path d="M242 200c30-30 30-70-4-80 0 34 0 56 4 80Z" class="f-brand-soft" />
      <path d="M98 150c-28-8-44-34-30-58 22 12 30 34 30 58Z" class="f-brand" />
      <path d="M262 150c28-8 44-34 30-58-22 12-30 34-30 58Z" class="f-brand" />
      <Bloom x={180} y={112} r={40} kind="peony" tone="accent" />
      <Bloom x={120} y={138} r={32} tone="paper" />
      <Bloom x={240} y={136} r={32} tone="accent-deep" />
      <Bloom x={150} y={186} r={28} kind="daisy" tone="paper" />
      <Bloom x={212} y={190} r={30} kind="peony" tone="paper" />
      <Bloom x={128} y={74} r={18} kind="bud" tone="accent" />
      <Bloom x={236} y={70} r={18} kind="bud" tone="accent-deep" />
      <Bloom x={180} y={56} r={16} kind="daisy" tone="paper" />
      <rect x="160" y="250" width="44" height="34" rx="6" class="f-accent" />
      <path
        d="M182 266c-30-26-52-6-30 6 10 4 22 0 30-6Zm0 0c30-26 52-6 30 6-10 4-22 0-30-6Z"
        class="f-accent"
      />
      <path d="M182 268l-26 58M182 268l24 60" class="s-ribbon" />
    </svg>
  )
}
{
  kind === 'cake-hero' && (
    <svg class="art cake-hero-art" viewBox="0 0 360 380" aria-hidden="true" focusable="false">
      <path d="M150 352h60l-8-22h-44Z" class="f-gold" />
      <ellipse cx="180" cy="330" rx="138" ry="12" class="f-gold" />
      <rect x="70" y="244" width="220" height="84" rx="8" class="f-icing" />
      <rect x="70" y="282" width="220" height="16" class="f-brand-soft" />
      <ellipse cx="180" cy="244" rx="110" ry="9" class="f-icing-top" />
      <rect x="102" y="170" width="156" height="74" rx="8" class="f-icing" />
      <rect x="102" y="206" width="156" height="14" class="f-accent-soft" />
      <ellipse cx="180" cy="170" rx="78" ry="8" class="f-icing-top" />
      <rect x="130" y="108" width="100" height="62" rx="8" class="f-icing" />
      <ellipse cx="180" cy="108" rx="50" ry="7" class="f-icing-top" />
      <path d={scallop(70, 326, 220, 12)} class="piping" />
      <path d={scallop(102, 242, 156, 12)} class="piping" />
      <path class="piping piping-draw" pathLength="1" d={scallop(130, 168, 100, 10)} />
      <Bloom x={96} y={252} r={18} tone="accent" />
      <Bloom x={118} y={244} r={13} kind="daisy" tone="paper" />
      <Bloom x={262} y={176} r={15} kind="peony" tone="accent" />
      <Bloom x={244} y={170} r={11} tone="accent-deep" />
      <g class="hero-topper">
        <path d="M168 108V78M192 108V78" class="s-gold" />
        <path
          d="M168 80c-12-10-14-24-2-24 4 0 6 4 6 6 0-2 2-6 6-6 12 0 10 14-10 24Z"
          class="f-gold"
          transform="translate(-4 0)"
        />
        <path
          d="M192 80c-12-10-14-24-2-24 4 0 6 4 6 6 0-2 2-6 6-6 12 0 10 14-10 24Z"
          class="f-accent"
          transform="translate(-4 0)"
        />
      </g>
    </svg>
  )
}
{
  kind === 'film' && (
    <svg class="art film-art" viewBox="0 0 400 260" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="wd-frame">
          <rect width="150" height="124" rx="4" />
        </clipPath>
      </defs>
      <g class="film-strip">
        <rect x="0" y="40" width="680" height="180" rx="6" class="f-film" />
        {sprockets.map((x) => (
          <>
            <rect x={x} y="49" width="12" height="9" rx="2" class="f-sprocket" />
            <rect x={x} y="202" width="12" height="9" rx="2" class="f-sprocket" />
          </>
        ))}
        {frames.map((x, i) => (
          <g transform={`translate(${x} 68)`}>
            <g clip-path="url(#wd-frame)">
              {i === 0 && (
                <>
                  <rect width="150" height="124" class="f-accent-soft" />
                  <rect x="14" y="14" width="48" height="64" rx="3" class="f-white" />
                  <path d="M38 14v64M14 46h48" class="s-pane" />
                  <path d="M62 30 120 124H40L14 78Z" class="f-white" opacity=".35" />
                  <path d="M100 14v8M86 30l14-8 14 8Z" class="s-gold" />
                  <path d="M92 32h16l16 76H76Z" class="f-white" />
                  <path d="M92 32h16l-2 16h-12Z" class="f-accent" opacity=".5" />
                  <rect x="0" y="108" width="150" height="16" class="f-wood" />
                  <path d="M30 108c-4-10 4-16 8-16s10 6 6 16Z" class="f-brand-soft" />
                  <Bloom x={34} y={88} r={7} tone="accent-deep" />
                </>
              )}
              {i === 1 && (
                <>
                  <rect width="150" height="124" class="f-paper-dim" />
                  <path d="M0 98h150v26H0Z" class="f-brand-soft" />
                  <path d="M52 124 68 98h14l16 26Z" class="f-white" opacity=".7" />
                  <path d="M40 124V62a35 35 0 0 1 70 0v62" class="s-arch" />
                  <Bloom x={42} y={74} r={8} tone="accent" />
                  <Bloom x={56} y={40} r={8} kind="peony" tone="paper" />
                  <Bloom x={75} y={28} r={9} tone="accent-deep" />
                  <Bloom x={94} y={40} r={8} kind="peony" tone="accent" />
                  <Bloom x={108} y={74} r={8} tone="paper" />
                  <Couple x={74} y={116} s={0.78} skin={['#c98f6b', '#f0c7a8']} />
                </>
              )}
              {i === 2 && (
                <>
                  <rect width="150" height="124" class="f-brand-deep" />
                  <path d="M0 18q75 34 150 0" class="s-lights" />
                  {bulbs.map((x) => (
                    <circle
                      cx={x}
                      cy={18 + 34 * (1 - ((x - 75) / 75) ** 2) * 0.5}
                      r="3.2"
                      class="f-gold-soft"
                    />
                  ))}
                  <ellipse cx="75" cy="118" rx="62" ry="10" class="f-brand" />
                  <Couple x={75} y={116} s={0.8} skin={['#f0c7a8', '#7a4b33']} dark />
                </>
              )}
              {i === 3 && (
                <>
                  <rect width="150" height="124" class="f-paper-dim" />
                  <rect x="55" y="46" width="40" height="30" rx="6" class="s-placeholder" />
                  <circle cx="75" cy="61" r="9" class="s-placeholder" />
                  <path d="M66 46l4-6h10l4 6" class="s-placeholder" />
                </>
              )}
              {i < 3 && (
                <>
                  <rect class="frame-tint" width="150" height="124" data-seg={`${i + 1} 0 1`} />
                  <rect class="frame-blank" width="150" height="124" data-seg={`${i + 1} 0 1`} />
                </>
              )}
            </g>
          </g>
        ))}
      </g>
    </svg>
  )
}
{
  kind === 'bouquet' && (
    <svg class="art bouquet-art" viewBox="0 0 400 280" aria-hidden="true" focusable="false">
      <rect x="22" y="44" width="96" height="196" rx="16" class="f-white card-shadow" />
      <rect x="40" y="62" width="60" height="6" rx="3" class="f-brand-soft" />
      {(['accent', 'paper', 'brand-soft'] as const).map((tone, i) => (
        <g transform={`translate(70 ${108 + i * 50})`}>
          <circle r="20" class="swatch-ring" />
          <circle
            r="20"
            class={`swatch f-${tone} bloom-edge`}
            data-seg={`1 ${(i * 0.28).toFixed(2)} ${(i * 0.28 + 0.44).toFixed(2)}`}
          />
        </g>
      ))}
      <g class="leaf-group">
        {leaves.map((leaf, i) => (
          <g transform={`translate(${leaf.x} ${leaf.y}) rotate(${leaf.a})`}>
            <path
              class="leaf f-brand-soft"
              d="M0 0c10-12 30-12 38 0-8 10-28 10-38 0Z"
              data-seg={`2 ${(0.1 + i * 0.18).toFixed(2)} ${(0.4 + i * 0.18).toFixed(2)}`}
            />
          </g>
        ))}
      </g>
      <g class="s-stems">
        {bouquet.map((b, i) => (
          <path
            class="stem"
            pathLength="1"
            d={`M${b.x} ${b.y} L258 206 L${246 + i * 4} 270`}
            data-seg={stemSeg(i)[0]}
          />
        ))}
      </g>
      {bouquet.map((b, i) => (
        <Bloom
          x={b.x}
          y={b.y}
          r={b.r}
          kind={b.kind}
          tone={b.tone}
          class="grow"
          seg={stemSeg(i)[1]}
        />
      ))}
      <rect
        x="244"
        y="196"
        width="30"
        height="22"
        rx="4"
        class="ribbon-wrap f-accent"
        data-seg="3 0 0.35"
      />
      <path
        class="ribbon s-ribbon"
        pathLength="1"
        d="M259 206c-34-30-58-4-30 6 10 3 20-1 30-6"
        data-seg="3 0.3 0.62"
      />
      <path
        class="ribbon s-ribbon"
        pathLength="1"
        d="M259 206c34-30 58-4 30 6-10 3-20-1-30-6"
        data-seg="3 0.42 0.74"
      />
      <path class="ribbon s-ribbon" pathLength="1" d="M259 208l-22 52" data-seg="3 0.66 0.9" />
      <path class="ribbon s-ribbon" pathLength="1" d="M259 208l20 54" data-seg="3 0.74 1" />
    </svg>
  )
}
{
  kind === 'tiers' && (
    <svg class="art tiers-art" viewBox="0 0 400 300" aria-hidden="true" focusable="false">
      <path d="M170 292h60l-10-26h-40Z" class="f-gold" />
      <ellipse cx="200" cy="264" rx="138" ry="11" class="f-gold" />
      {tiers.map((t, i) => (
        <g class="tier" data-seg={`${i + 1} 0 0.55`}>
          <rect x={t.x} y={t.y} width={t.w} height={t.h} rx="8" class="f-icing" />
          <rect x={t.x} y={t.y + t.h * 0.5} width={t.w} height={t.h * 0.2} class={`f-${t.band}`} />
          <ellipse cx={t.x + t.w / 2} cy={t.y} rx={t.w / 2} ry="7" class="f-icing-top" />
        </g>
      ))}
      {tiers.map((t, i) => (
        <path
          class="piping"
          pathLength="1"
          d={scallop(t.x, t.y + t.h - 2, t.w, 11)}
          data-seg={`${i + 1} 0.5 0.95`}
        />
      ))}
      <Bloom x={112} y={196} r={14} tone="accent" class="grow" seg="1 0.8 1" />
      <Bloom x={268} y={138} r={12} kind="peony" tone="accent" class="grow" seg="2 0.8 1" />
