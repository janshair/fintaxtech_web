      {kind === 'first-dance' && (
        <>
          <rect width="200" height="200" class="f-brand-deep" />
          <path d="M0 30q100 50 200 0" class="s-lights" />
          {[14, 42, 70, 100, 130, 158, 186].map((x) => (
            <circle cx={x} cy={30 + 25 * (1 - ((x - 100) / 100) ** 2)} r="4" class="f-gold-soft" />
          ))}
          <ellipse cx="100" cy="180" rx="80" ry="14" class="f-brand" />
          <Couple x={100} y={178} s={1.15} dark skin={['#e3b296', '#c98f6b']} />
        </>
      )}
      {kind === 'bridal-bouquet' && (
        <>
          <rect width="200" height="200" class="f-accent-soft" />
          <g class="s-stems">
            {[86, 94, 102, 110].map((x) => (
              <path d={`M${x} 110 L${96 + (x - 98) / 3} 190`} />
            ))}
          </g>
          <Bloom x={100} y={74} r={26} kind="peony" tone="paper" />
