  tile && (
    <svg class="art tile-svg" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
      {kind === 'getting-ready' && (
        <>
          <rect width="200" height="200" class="f-accent-soft" />
          <rect x="20" y="22" width="70" height="96" rx="4" class="f-white" />
          <path d="M55 22v96M20 70h70" class="s-pane" />
          <path d="M90 50 170 200H60L20 118Z" class="f-white" opacity=".3" />
          <path d="M138 20v10M118 42l20-12 20 12Z" class="s-gold" />
          <path d="M128 44h20l26 116h-72Z" class="f-white" />
          <path d="M128 44h20l-2 24h-16Z" class="f-accent" opacity=".5" />
          <rect y="168" width="200" height="32" class="f-wood" />
          <path d="M40 168c-6-14 6-22 12-22s16 8 10 22Z" class="f-brand-soft" />
          <Bloom x={46} y={140} r={10} tone="accent-deep" />
        </>
      )}
      {kind === 'rings' && (
        <>
          <rect width="200" height="200" class="f-paper-dim" />
          <ellipse cx="100" cy="150" rx="70" ry="12" class="f-brand-soft" opacity=".5" />
          <circle cx="84" cy="104" r="34" class="s-ring" />
          <circle cx="120" cy="110" r="30" class="s-ring" />
          <path d="M76 66l8-10 8 10-8 8Z" class="f-white diamond" />
          <Bloom x={156} y={52} r={18} tone="accent" />
          <Bloom x={40} y={160} r={14} kind="daisy" tone="paper" />
        </>
      )}
      {kind === 'confetti' && (
        <>
          <rect width="200" height="200" class="f-brand-soft" />
          <rect y="160" width="200" height="40" class="f-paper-dim" />
          {confetti.map(([x, y, tone], i) => (
            <rect
              x={x}
              y={y}
              width="8"
              height="5"
              rx="1.5"
              transform={`rotate(${i * 37} ${x} ${y})`}
              class={`f-${tone}`}
            />
          ))}
          <Couple x={100} y={178} s={1.2} skin={['#9a6447', '#e3b296']} />
        </>
      )}
      {kind === 'golden-hour' && (
        <>
          <rect width="200" height="200" class="f-accent-soft" />
          <circle cx="132" cy="96" r="40" class="f-gold-soft" />
          <path d="M0 150c50-34 110-40 200-12v62H0Z" class="f-brand" />
          <Couple x={84} y={150} s={0.95} dark skin={['#5b3a2a', '#5b3a2a']} />
        </>
      )}
      {kind === 'details' && (
        <>
          <rect width="200" height="200" class="f-paper-dim" />
          <g transform="rotate(-8 90 100)">
            <rect x="40" y="46" width="96" height="124" rx="4" class="f-white card-shadow" />
            <path d="M58 76h60M64 92h48M58 120h60M70 136h36" class="s-lines" />
