        <path d="M188 82V52M212 82V52" class="s-gold" />
        <path
          d="M184 54c-12-10-14-24-2-24 4 0 6 4 6 6 0-2 2-6 6-6 12 0 10 14-10 24Z"
          class="f-gold"
        />
        <path
          d="M208 54c-12-10-14-24-2-24 4 0 6 4 6 6 0-2 2-6 6-6 12 0 10 14-10 24Z"
          class="f-accent"
        />
      </g>
    </svg>
  )
}
{
  kind === 'map' && (
    <svg class="map-drawing" viewBox="0 0 360 200" aria-hidden="true" focusable="false">
      <rect width="360" height="200" class="f-brand-soft" />
      <path d="M-10 140C90 110 170 170 370 90" class="s-road" stroke-width="16" />
      <path d="M110-10 140 210M250-10l-30 220" class="s-road" stroke-width="10" />
      <rect x="24" y="22" width="70" height="46" rx="8" class="f-accent-soft" />
      <rect x="268" y="132" width="70" height="48" rx="8" class="f-accent-soft" />
      <path
        d="M190 50c-17 0-30 13-30 30 0 23 30 50 30 50s30-27 30-50c0-17-13-30-30-30Z"
        class="f-brand"
      />
      <circle cx="190" cy="80" r="11" class="f-accent" />
    </svg>
  )
}
