---
interface Props {
  kind?: 'hero' | 'bar' | 'weights' | 'studio' | 'cardio';
}
const { kind = 'hero' } = Astro.props;
// Original SVG illustrations created for this demo; no external images or licensed artwork.
// Brand-coloured parts use .f-* classes so THEME recolours them; kit metal stays fixed.
---

{
  kind === 'hero' && (
    <svg
      class="gym-art hero-kettlebell"
      viewBox="0 0 520 520"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      {/* Nested groups keep each motion layer on its own transform:
          scroll swing > tap swing > ambient sway > entrance drop. */}
      <g class="kb-halo">
        <circle cx="260" cy="262" r="236" class="f-accent-soft" />
      </g>
      <path d="M48 410h424" stroke="#00000014" stroke-width="2" />
      <ellipse class="kb-shadow" cx="262" cy="452" rx="168" ry="20" fill="#0000001f" />
      <g class="kb-scroll">
        <g class="kb-tap">
          <g class="kb-sway">
            <g class="kb-drop">
              <path
                d="M176 244c-22-112 190-112 168 0"
                class="s-brand-deep"
                stroke-width="52"
                stroke-linecap="round"
              />
              <path
                d="M176 244c-22-112 190-112 168 0"
                class="s-brand"
                stroke-width="34"
                stroke-linecap="round"
              />
              <path
                d="M205 160c22-26 86-26 108 0"
                stroke="#ffffff38"
                stroke-width="7"
                stroke-linecap="round"
              />
              <path d="M136 430h248l-14-30H150Z" class="f-brand-deep" />
              <circle cx="260" cy="314" r="148" class="f-brand" />
              <path
                d="M154 268c18-58 70-94 128-96"
                stroke="#ffffff30"
                stroke-width="16"
                stroke-linecap="round"
              />
              <rect x="170" y="262" width="180" height="128" rx="30" class="f-accent" />
              <g class="kb-mark">
                <text
                  x="260"
                  y="330"
                  text-anchor="middle"
                  dominant-baseline="central"
                  class="kettlebell-mark f-on-accent"
                  data-monogram
                >
                  HF
                </text>
              </g>
            </g>
          </g>
        </g>
      </g>
      <g class="db-scroll">
        <g class="hero-dumbbell">
          <rect x="350" y="404" width="112" height="14" rx="7" fill="#a7aab3" />
          <rect x="356" y="384" width="22" height="54" rx="6" class="f-brand-deep" />
          <rect x="434" y="384" width="22" height="54" rx="6" class="f-brand-deep" />
          <rect x="340" y="392" width="14" height="38" rx="5" class="f-brand" />
          <rect x="458" y="392" width="14" height="38" rx="5" class="f-brand" />
        </g>
      </g>
      <g class="pl-scroll">
        <g class="hero-plates">
          <ellipse cx="96" cy="424" rx="62" ry="15" class="f-brand-deep" />
          <ellipse cx="96" cy="414" rx="62" ry="15" class="f-accent" />
          <ellipse cx="96" cy="398" rx="50" ry="12" class="f-brand-deep" />
          <ellipse cx="96" cy="390" rx="50" ry="12" class="f-brand" />
          <ellipse cx="96" cy="390" rx="10" ry="3" fill="#00000040" />
        </g>
      </g>
      <path class="spark spark-1 f-brand" d="m408 120 8 20 20 8-20 8-8 20-8-20-20-8 20-8Z" />
      <path class="spark spark-2 f-brand" d="m88 150 5 12 12 5-12 5-5 12-5-12-12-5 12-5Z" />
    </svg>
  )
}
{
  kind === 'bar' && (
    <svg
      class="gym-art lift-art"
      viewBox="0 0 640 400"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="640" height="400" rx="28" class="f-brand-soft" />
      <path d="M0 316h640v56a28 28 0 0 1-28 28H28a28 28 0 0 1-28-28Z" fill="#3b3a40" />
      <path d="M0 316h640" stroke="#57565e" stroke-width="4" />
      <path d="M160 316v84M320 316v84M480 316v84" stroke="#4a4950" stroke-width="3" />
      <g class="rack">
        <rect x="146" y="64" width="18" height="254" rx="4" class="f-brand-deep" />
        <rect x="476" y="64" width="18" height="254" rx="4" class="f-brand-deep" />
        <rect x="122" y="306" width="66" height="14" rx="5" class="f-brand" />
        <rect x="452" y="306" width="66" height="14" rx="5" class="f-brand" />
        <path
          d="M164 218h12v-14M476 218h-12v-14"
          stroke="#9a9ea8"
          stroke-width="6"
          stroke-linecap="round"
        />
        <path
          d="M150 90v200M480 90v200"
          stroke="#ffffff1f"
          stroke-width="3"
          stroke-dasharray="2 14"
        />
      </g>
      <g class="chalk" opacity="0">
        <circle cx="180" cy="200" r="12" fill="#ffffffb0" />
        <circle cx="192" cy="188" r="8" fill="#ffffff90" />
        <circle cx="460" cy="200" r="12" fill="#ffffffb0" />
        <circle cx="448" cy="188" r="8" fill="#ffffff90" />
      </g>
      <g class="lift">
        <rect x="132" y="203" width="376" height="10" rx="5" fill="#b9bcc4" />
        <path d="M240 208h40m80 0h40" stroke="#8d919b" stroke-width="10" stroke-dasharray="2 4" />
        <rect x="26" y="197" width="106" height="22" rx="6" fill="#9a9ea8" />
        <rect x="508" y="197" width="106" height="22" rx="6" fill="#9a9ea8" />
        <rect x="128" y="190" width="10" height="36" rx="3" fill="#7c808a" />
        <rect x="502" y="190" width="10" height="36" rx="3" fill="#7c808a" />
        <g class="plate plate-l1">
          <rect x="106" y="130" width="22" height="156" rx="7" class="f-accent-deep" />
          <rect x="110" y="134" width="14" height="148" rx="5" class="f-accent" />
        </g>
        <g class="plate plate-r1">
          <rect x="512" y="130" width="22" height="156" rx="7" class="f-accent-deep" />
          <rect x="516" y="134" width="14" height="148" rx="5" class="f-accent" />
        </g>
        <g class="plate plate-l2">
          <rect x="86" y="152" width="18" height="112" rx="6" class="f-brand-deep" />
          <rect x="89" y="156" width="12" height="104" rx="4" class="f-brand" />
        </g>
        <g class="plate plate-r2">
          <rect x="536" y="152" width="18" height="112" rx="6" class="f-brand-deep" />
          <rect x="539" y="156" width="12" height="104" rx="4" class="f-brand" />
        </g>
        <g class="collar">
          <rect x="72" y="192" width="12" height="32" rx="3" fill="#5f636c" />
          <rect x="556" y="192" width="12" height="32" rx="3" fill="#5f636c" />
        </g>
      </g>
      <g class="done-tick" opacity="0">
        <circle cx="320" cy="356" r="26" class="f-accent" />
        <path
          d="m307 356 9 9 18-19"
          class="s-on-accent"
          stroke-width="6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )
}
{
  kind === 'weights' && (
    <svg
      class="gym-art scene-art"
      viewBox="0 0 480 340"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="480" height="340" class="f-brand-soft" />
      <rect x="0" y="0" width="480" height="200" fill="#ffffff55" />
      <path d="M0 250h480v90H0Z" fill="#3b3a40" />
      <path d="M0 250h480" stroke="#57565e" stroke-width="4" />
      <rect x="36" y="40" width="160" height="96" rx="8" class="f-brand" />
      <path d="M56 70h120M56 92h80" stroke="#ffffff40" stroke-width="8" stroke-linecap="round" />
      <rect x="60" y="150" width="14" height="104" class="f-brand-deep" />
      <rect x="170" y="150" width="14" height="104" class="f-brand-deep" />
      <rect x="40" y="176" width="164" height="8" rx="4" fill="#a7aab3" />
      <rect x="34" y="150" width="12" height="60" rx="4" class="f-accent" />
      <rect x="198" y="150" width="12" height="60" rx="4" class="f-accent" />
      <rect x="236" y="168" width="214" height="10" rx="5" class="f-brand-deep" />
      <rect x="244" y="178" width="10" height="74" class="f-brand-deep" />
      <rect x="432" y="178" width="10" height="74" class="f-brand-deep" />
      <rect x="236" y="208" width="214" height="10" rx="5" class="f-brand-deep" />
      {[262, 300, 338, 376, 414].map((x, i) => (
        <g>
          <rect x={x - 12} y={154 - i * 2} width="10" height={18 + i * 2} rx="3" class="f-brand" />
          <rect x={x + 8} y={154 - i * 2} width="10" height={18 + i * 2} rx="3" class="f-brand" />
          <rect x={x - 4} y="160" width="14" height="5" fill="#a7aab3" />
        </g>
      ))}
      {[262, 312, 362, 412].map((x) => (
        <g>
          <rect x={x - 8} y="190" width="9" height="20" rx="3" class="f-accent" />
          <rect x={x + 14} y="190" width="9" height="20" rx="3" class="f-accent" />
          <rect x={x} y="197" width="16" height="5" fill="#a7aab3" />
        </g>
      ))}
      <rect x="226" y="270" width="140" height="18" rx="6" class="f-brand" />
      <rect x="236" y="288" width="10" height="30" fill="#2b2a30" />
      <rect x="346" y="288" width="10" height="30" fill="#2b2a30" />
    </svg>
  )
}
{
  kind === 'studio' && (
    <svg
      class="gym-art scene-art"
      viewBox="0 0 480 340"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="480" height="340" class="f-accent-soft" />
      <rect x="40" y="34" width="400" height="150" rx="6" fill="#ffffff80" />
      <path d="M140 34v150M240 34v150M340 34v150" stroke="#ffffffcc" stroke-width="4" />
      <path d="M0 230h480v110H0Z" fill="#c9a77c" />
      <path d="M0 230h480M0 270h480M0 310h480" stroke="#b38f63" stroke-width="3" />
      <path d="M60 250h120l-18 50H42Z" class="f-brand" />
      <path d="M200 250h120l-10 50H190Z" class="f-brand-mid" />
      <path d="M340 250h120l18 50H358Z" class="f-brand" />
      {[70, 130, 190, 250, 310, 370].map((x, i) => (
        <g>
          <path
            d={`M${x + 4} 200c-6-26 34-26 28 0`}
            class={i % 2 ? 's-accent-deep' : 's-brand-deep'}
            stroke-width="8"
            stroke-linecap="round"
          />
          <circle cx={x + 18} cy="216" r="20" class={i % 2 ? 'f-accent-deep' : 'f-brand-deep'} />
        </g>
      ))}
      <circle cx="420" cy="80" r="26" class="f-brand" />
      <path d="M412 70v22l18-11Z" class="f-accent" />
    </svg>
  )
}
{
  kind === 'cardio' && (
    <svg
      class="gym-art scene-art"
      viewBox="0 0 480 340"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="480" height="340" class="f-brand-soft" />
      <rect x="250" y="30" width="200" height="150" rx="10" fill="#dfe9f2" />
      <path d="M350 30v150M250 105h200" stroke="#ffffff" stroke-width="6" />
      <path d="M270 160c40-40 90-50 160-40v60H270Z" fill="#b9cfc0" />
      <path d="M0 250h480v90H0Z" fill="#3b3a40" />
      <path d="M0 250h480" stroke="#57565e" stroke-width="4" />
      <g>
        <circle cx="96" cy="230" r="34" stroke="#2b2a30" stroke-width="10" />
        <path
          d="M96 230 70 150h40M70 150l-14-6M96 230l50-60 12-30h22"
          class="s-brand"
          stroke-width="12"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <rect x="132" y="128" width="40" height="12" rx="6" class="f-accent" />
        <path d="M60 264h80" stroke="#2b2a30" stroke-width="10" stroke-linecap="round" />
      </g>
      <g>
        <rect x="220" y="246" width="230" height="16" rx="8" class="f-brand-deep" />
        <rect x="236" y="226" width="44" height="20" rx="6" class="f-accent" />
        <circle cx="420" cy="234" r="26" class="f-brand" />
        <circle cx="420" cy="234" r="10" fill="#2b2a30" />
        <path d="M318 236h70" stroke="#a7aab3" stroke-width="6" stroke-linecap="round" />
        <path d="M230 262v20m210-20v20" stroke="#2b2a30" stroke-width="8" stroke-linecap="round" />
      </g>
    </svg>
  )
}
