---
import PhoneFrame from '../mobile/PhoneFrame.astro';
import salon from '../../../assets/booking/fern-studio.webp';
import { bookingDate, bookingTimes, treatments } from '../../../content/mobile-app-templates';
interface Props {
  platform: 'android' | 'ios';
}
const { platform } = Astro.props;
---

<PhoneFrame platform={platform} name="Fern Studio" photo={salon} backLabel="Previous booking step">
  <div data-panel="0" hidden>
    <h3 tabindex="-1">Treatments</h3><p>Choose your service</p>
    <div class="treatments">
      {
        treatments.map(({ name, details }, i) => (
          <button type="button" data-service={i} aria-pressed={i === 0}>
            <>
              <strong>{name}</strong>
              <small>{details}</small>
            </>
          </button>
        ))
      }
    </div>
  </div>
  <div data-panel="1">
    <h3 tabindex="-1" data-name>{treatments[0].name}</h3><p data-duration>
      {treatments[0].details}
    </p>
    <p class="appointment-date">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="17"
        height="17"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        ><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M7 3v5m10-5v5M3 11h18"
        ></path></svg
      >{bookingDate}
    </p>
  </div>
  <div data-panel="2" hidden>
    <h3 tabindex="-1" data-review-title>Review booking</h3><p data-appointment></p>
    <p class="appointment-date">{bookingDate}</p><p data-review-time></p>
  </div>
  <div data-panel="3" hidden>
    <h3 tabindex="-1">Move your visit</h3><p data-current></p><p class="appointment-date">
      Choose a new time
    </p>
  </div>
  <div class="time-choices" aria-label="Appointment times" role="group">
    {
      bookingTimes.map((time) => (
        <button type="button" data-time={time} aria-pressed={time === '11:30'}>
          {time}
        </button>
      ))
    }
  </div>
  <button class="phone-action" type="button" data-next>Continue</button>
</PhoneFrame>
