# Server runtime only (local dev/preview or the production brief service).
# Never expose this in browser code or static output; restart local servers after changes.
SLACK_WEBHOOK=
# Production service only; local dev/preview uses the current loopback origin.
BRIEF_ORIGIN=https://fintaxtech.co.uk
BRIEF_API_HOST=127.0.0.1
BRIEF_API_PORT=4324
# Comma-separated trusted proxy socket addresses; leave empty without a proxy.
BRIEF_TRUSTED_PROXIES=
# Public configuration, intentionally available to the static site:
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_WEB3FORMS_KEY=

# Optional barber counter, disabled until configured. Own HTTPS host, /visits only.
PUBLIC_BARBER_VISIT_ENDPOINT=
PUBLIC_BARBER_REF_CODES=
# Separate Node runtime only; not automatically loaded from .env by the service.
BARBER_REF_CODES=
BARBER_COUNTS_FILE=
BARBER_VISIT_PORT=4326
